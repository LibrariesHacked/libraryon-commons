{
  "name": "libraryon-commons",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4322",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "package:netlify-admin": "node scripts/package-netlify-admin.mjs",
    "test": "node --test",
    "sync:news": "node scripts/sync-news.mjs",
    "sync:activity": "node scripts/sync-activity.mjs",
    "directory:schemas": "node scripts/directory-schemas.mjs",
    "directory:lookups": "node scripts/directory/lookups.mjs",
    "directory:migrate": "node scripts/directory/migrate.mjs",
    "directory:check": "node scripts/directory/check-directory.mjs",
    "format": "prettier --write astro.config.mjs .prettierrc.json \"src/**/*.{astro,js,mjs,css}\" src/data/*.json \"scripts/**/*.{mjs,js,cjs}\" \"tests/**/*.{mjs,js,cjs}\" package.json \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check astro.config.mjs .prettierrc.json \"src/**/*.{astro,js,mjs,css}\" src/data/*.json \"scripts/**/*.{mjs,js,cjs}\" \"tests/**/*.{mjs,js,cjs}\" package.json \".github/workflows/*.{yml,yaml}\"",
    "archive": "node scripts/archive/collect.mjs",
    "capture": "node scripts/archive/capture.mjs",
    "import:archive": "node scripts/archive/import.mjs",
    "compact:archive": "node scripts/archive/compact.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@geovation/gb-name-index": "github:Geovation/gb-name-index#v1.0.0",
    "@github/combobox-nav": "^3.0.2",
    "@lucide/astro": "^1.62.0",
    "astro": "^7.4.2",
    "cheerio": "1.1.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "lucide": "^1.62.0",
    "maplibre-gl": "^6.16.0",
    "mdast-util-to-markdown": "^2.2.1",
    "open-props": "^1.7.23",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "playwright": "1.56.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "proj4": "^2.22.0",
    "read-excel-file": "^9.3.14",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
