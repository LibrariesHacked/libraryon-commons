---
import { ArrowUpRight } from '@lucide/astro';
import { articleImage, articleTitle, sitePath } from '../lib/site.mjs';
const { entries } = Astro.props;
---

<div class="article-grid">
  {entries.map((entry) => {
    const image = articleImage(entry);
    return (
      <a class="article-card content-card" href={sitePath(entry.data.path)}>
        {image ? (
          <img src={sitePath(image.url)} alt={image.alt} loading="lazy" width="640" height="400" />
        ) : (
          <div class="card-placeholder" aria-hidden="true">
            LibraryCommons
          </div>
        )}
        <div class="content-card-body">
          <h3 class="content-card-heading">
            <span>{articleTitle(entry)}</span> <ArrowUpRight class="content-card-arrow" size={20} aria-hidden="true" />
          </h3>
          {entry.data.description && <p>{entry.data.description}</p>}
        </div>
      </a>
    );
  })}
</div>
