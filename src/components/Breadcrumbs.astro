---
import { ChevronRight } from '@lucide/astro'
import { settings, sitePath } from '../lib/site.mjs'
const { items = [] } = Astro.props
---

{items.length > 0 && (
  <nav class="breadcrumbs" aria-label={settings.ui.editorial.breadcrumb_aria_label}>
    {items.map((item, index) => (
      <>
        {index > 0 && <ChevronRight size={13} aria-hidden="true" />}
        {item.href ? (
          <a href={sitePath(item.href)}>{item.label}</a>
        ) : (
          <span aria-current={item.current ? 'page' : undefined}>{item.label}</span>
        )}
      </>
    ))}
  </nav>
)}
