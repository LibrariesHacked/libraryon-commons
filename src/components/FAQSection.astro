---
import { settings } from '../lib/site.mjs';
import { render } from 'astro:content';
const { items = [], heading = settings.ui.editorial.faq_heading, headingId = 'page-faqs', introduction = '' } = Astro.props;
const answers = await Promise.all(items.map(async (entry) => ({
  question: entry.data.question,
  ...(await render(entry))
})));
---

{answers.length > 0 && (
  <section class="faq-section structured-faq">
    <h2 id={headingId}>{heading}</h2>
    <Fragment set:html={introduction} />
    <div class="faq-list">
      {answers.map(({ question, Content }) => (
        <details class="faq-item">
          <summary>{question}</summary>
          <div class="faq-answer"><Content /></div>
        </details>
      ))}
    </div>
  </section>
)}