---
import { ChevronLeft, ChevronRight, Pause, Play } from '@lucide/astro'

import LibrarySearch from './LibrarySearch.astro'
import { sitePath } from '../lib/site/siteHelpers.mjs'

const { copy, heading, highlightedHeading, intro, hero, carousel = [] } = Astro.props
---

<section class:list={['hero', carousel.length > 0 ? 'hero-with-carousel' : !hero && 'hero-plain']}>
  {!carousel.length && hero && (
    <img src={sitePath(hero.url)} alt={hero.alt} width="1600" height="600" fetchpriority="high" />
  )}
  <div class="shell hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>
        {highlightedHeading ? (
          <>
            {highlightedHeading[1]}
            <span class="hero-title-highlight">{highlightedHeading[2]}</span>
          </>
        ) : (
          heading
        )}
      </h1>
      <p>{intro}</p>
      <LibrarySearch id="home-library" />
    </div>
    {carousel.length > 0 && (
      <div
        class="hero-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="Featured library images"
        data-hero-carousel
      >
        <div class="hero-carousel-viewport" data-carousel-viewport tabindex="0">
          <ul class="hero-carousel-track" data-carousel-track>
            {carousel.map((slide, index) => (
              <li
                class="hero-carousel-slide"
                role="group"
                aria-roledescription="slide"
                aria-label={`Slide ${index + 1} of ${carousel.length}`}
                data-carousel-slide={index}
              >
                <figure class="hero-carousel-card">
                  <img
                    src={sitePath(slide.image)}
                    alt={slide.alt}
                    width="800"
                    height="600"
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                </figure>
              </li>
            ))}
          </ul>
        </div>
        <div class="hero-carousel-toolbar">
          <div class="hero-carousel-dots" role="group" aria-label="Choose slide">
            {carousel.map((slide, index) => (
              <button
                type="button"
                class="hero-carousel-dot"
                data-carousel-dot={index}
                aria-label={`Go to slide ${index + 1}`}
                aria-current={index === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
          <div class="hero-carousel-controls">
            <button
              type="button"
              class="hero-carousel-btn"
              data-carousel-prev
              aria-label="Previous image"
              title="Previous image"
            >
              <ChevronLeft size={18} aria-hidden="true" />
            </button>
            <button
              type="button"
              class="hero-carousel-btn"
              data-carousel-next
              aria-label="Next image"
              title="Next image"
            >
              <ChevronRight size={18} aria-hidden="true" />
            </button>
            <button
              type="button"
              class="hero-carousel-btn hero-carousel-toggle"
              data-carousel-toggle
              aria-pressed="false"
              aria-label="Pause carousel"
              title="Pause carousel"
            >
              <span data-icon-pause>
                <Pause size={16} aria-hidden="true" />
              </span>
              <span data-icon-play hidden>
                <Play size={16} aria-hidden="true" />
              </span>
            </button>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

{carousel.length > 0 && <script src="../scripts/carouselClient.mjs"></script>}
