---
import { Download, FileCheck, FileJson } from '@lucide/astro'
import { libraryValidationReport } from '../lib/directory/exportHelpers.mjs'
import { sitePath } from '../lib/site/siteHelpers.mjs'

const { entries, authoritySlug, authorityName } = Astro.props
const prefix = authoritySlug ? `/libraries/${authoritySlug}/libraries` : '/libraries'
const report = libraryValidationReport(entries)
const heading = authoritySlug ? 'Download library data' : 'Download directory data'
const description = authoritySlug
  ? `Download a spreadsheet of all ${report.totalRecords.toLocaleString('en-GB')} libraries in ${authorityName || 'this service'}, including addresses, facilities, and contact details.`
  : `Download all ${report.totalRecords.toLocaleString('en-GB')} UK public libraries as a spreadsheet for research, mapping, or local planning.`
---

<section class="detail-section library-downloads" aria-label="Library data downloads">
  <h2>{heading}</h2>
  <p class="muted">{description}</p>
  <a
    class="button button-secondary"
    href={sitePath(`${prefix}.csv`)}
    download={authoritySlug ? `libraries-${authoritySlug}.csv` : 'libraries.csv'}
  >
    <Download size={17} aria-hidden="true" /> Download spreadsheet (CSV)
  </a>
  <details>
    <summary>Data schema and developer formats</summary>
    <ul class="contact-list">
      <li>
        <a
          href={sitePath(`${prefix}.validated.csv`)}
          download={
            authoritySlug ? `libraries-${authoritySlug}.validated.csv` : 'libraries.validated.csv'
          }
        >
          <FileCheck size={17} aria-hidden="true" /> Validated records only (
          {report.validRecords.toLocaleString('en-GB')} CSV)
        </a>
      </li>
      <li>
        <a href={sitePath(`${prefix}.validation.json`)} download>
          <FileJson size={17} aria-hidden="true" /> Quality & validation report (JSON)
        </a>
      </li>
      <li>
        <a href={sitePath('/schemas/libraries.json')} download>
          <FileJson size={17} aria-hidden="true" /> Table Schema definition (JSON)
        </a>
      </li>
    </ul>
  </details>
</section>

<style>
  .library-downloads {
    margin-block: 1.5rem;
  }
  .library-downloads h2 {
    font-size: 1.25rem;
  }
  .library-downloads details {
    margin-top: 0.75rem;
  }
  .library-downloads summary {
    cursor: pointer;
  }
</style>
