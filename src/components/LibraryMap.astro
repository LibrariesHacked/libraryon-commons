---
import 'maplibre-gl/dist/maplibre-gl.css'
import { libraryMapFeatures } from '../lib/directory/geoHelpers.mjs'
import { sitePath } from '../lib/site/siteHelpers.mjs'

const {
  id = `library-map-${crypto.randomUUID()}`,
  libraries = [],
  label = 'Library locations',
  emptyMessage = 'No recorded library locations to show.'
} = Astro.props
const data = libraryMapFeatures(libraries, sitePath)
---

<library-map
  id={id}
  class="library-map"
  role="region"
  aria-label={label}
  data-empty-message={emptyMessage}
>
  <div class="library-map-canvas" data-map-canvas></div>
  <p class="library-map-status" data-map-status role="status" hidden>
    Loading map...
  </p>
  <script
    type="application/json"
    data-map-data
    set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
  />
  <noscript>
    <p class="notice">
      The map requires JavaScript. Library details and listings remain available on this page.
    </p>
  </noscript>
</library-map>

<script>
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'
  import { libraryMapFeatures } from '../lib/directory/geoHelpers.mjs'
  import { sitePath } from '../lib/site/siteHelpers.mjs'

  class LibraryMap extends HTMLElement {
    map = undefined
    popup = undefined
    PopupClass = undefined
    observer = undefined
    data = { type: 'FeatureCollection', features: [] }
    location = null
    initializing = false
    lifetime = undefined
    pendingSelect = null
    isProgrammaticPopupClose = false
    onPopupClose = null

    connectedCallback() {
      if (this.lifetime && !this.lifetime.signal.aborted) return
      this.lifetime = new AbortController()
      const { signal } = this.lifetime
      if (!this.dataset.initialized)
        this.data = JSON.parse(this.querySelector('[data-map-data]').textContent)
      this.dataset.initialized = 'true'
      this.addEventListener(
        'library-map-update',
        (event) => {
          const { records, location = null } = event.detail
          this.data = libraryMapFeatures(records, sitePath)
          this.location = location
          this.updateMap({ isInitial: false })
        },
        { signal }
      )
      this.addEventListener(
        'library-map-select',
        (event) => {
          const { library, unselect } = event.detail || {}
          if (unselect || !library) {
            this.removePopup()
            this.fitAllBounds()
            return
          }
          this.selectLibrary(library)
        },
        { signal }
      )

      // Start loading immediately if map is in or near viewport; otherwise observe with generous margin
      const rect = this.getBoundingClientRect()
      const inView =
        typeof window !== 'undefined' && rect.top < window.innerHeight + 400 && rect.bottom > -400
      if (inView) {
        this.initializeMap(signal)
      } else {
        this.observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return
            this.observer?.disconnect()
            this.initializeMap(signal)
          },
          { rootMargin: '400px' }
        )
        this.observer.observe(this)
      }
    }

    disconnectedCallback() {
      this.lifetime?.abort()
      this.observer?.disconnect()
      this.removePopup()
      this.map?.remove()
      this.map = undefined
      this.initializing = false
      delete this.dataset.mapReady
    }

    removePopup() {
      if (!this.popup) return
      this.isProgrammaticPopupClose = true
      const existingPopup = this.popup
      this.popup = null
      try {
        if (typeof existingPopup.off === 'function' && this.onPopupClose) {
          existingPopup.off('close', this.onPopupClose)
        }
        existingPopup.remove()
      } finally {
        this.isProgrammaticPopupClose = false
      }
    }

    setStatus(message = '') {
      const status = this.querySelector('[data-map-status]')
      if (!status) return
      status.textContent = message
      status.hidden = !message
    }

    async initializeMap(signal) {
      if (this.map || this.initializing) return
      this.initializing = true

      const loadingTimer = setTimeout(() => {
        if (!this.dataset.mapReady) this.setStatus('Loading map...')
      }, 300)

      try {
        const { Map, NavigationControl, FullscreenControl, ScaleControl, Popup, setWorkerUrl } =
          await import('maplibre-gl')
        if (!this.isConnected || signal.aborted) {
          clearTimeout(loadingTimer)
          return
        }
        setWorkerUrl(workerUrl)
        this.PopupClass = Popup

        // Pre-compute initial camera so the map starts directly at its target without flickering from UK overview
        const originPoints = this.location
          ? [[this.location.longitude, this.location.latitude]]
          : []
        const points = [
          ...(this.data?.features || []).map((f) => f.geometry?.coordinates),
          ...originPoints
        ].filter(Boolean)

        const cameraOptions = {
          center: [-3.5, 55],
          zoom: 4.5
        }
        if (points.length === 1) {
          cameraOptions.center = points[0]
          cameraOptions.zoom = 15.5
        } else if (points.length > 1) {
          const longitudes = points.map(([lng]) => lng)
          const latitudes = points.map(([, lat]) => lat)
          cameraOptions.bounds = [
            [Math.min(...longitudes), Math.min(...latitudes)],
            [Math.max(...longitudes), Math.max(...latitudes)]
          ]
          cameraOptions.fitBoundsOptions = { padding: 48, maxZoom: 14 }
        }

        const map = new Map({
          container: this.querySelector('[data-map-canvas]'),
          style: 'https://tiles.openfreemap.org/styles/positron',
          ...cameraOptions,
          renderWorldCopies: false,
          cooperativeGestures: false
        })
        this.map = map
        map.addControl(new NavigationControl(), 'top-right')
        map.addControl(new FullscreenControl(), 'top-right')
        map.addControl(new ScaleControl({ unit: 'imperial' }))
        map.on('error', () => {
          clearTimeout(loadingTimer)
          this.setStatus(
            'The map could not be fully loaded. Library details and listings remain available.'
          )
        })
        map.on('load', () => {
          clearTimeout(loadingTimer)
          const colors = getComputedStyle(this)
          const primary = colors.getPropertyValue('--brand-primary').trim()
          const paper = colors.getPropertyValue('--paper').trim()
          const muted = colors.getPropertyValue('--muted').trim()
          map.addSource('libraries', {
            type: 'geojson',
            data: this.data,
            cluster: true,
            clusterRadius: 45,
            clusterMaxZoom: 13
          })
          map.addLayer({
            id: 'library-clusters',
            type: 'circle',
            source: 'libraries',
            filter: ['has', 'point_count'],
            paint: {
              'circle-color': primary,
              'circle-radius': ['step', ['get', 'point_count'], 18, 100, 24],
              'circle-stroke-width': 2,
              'circle-stroke-color': paper
            }
          })
          map.addLayer({
            id: 'library-cluster-count',
            type: 'symbol',
            source: 'libraries',
            filter: ['has', 'point_count'],
            layout: {
              'text-field': '{point_count_abbreviated}',
              'text-font': ['Noto Sans Regular'],
              'text-size': 12
            },
            paint: { 'text-color': paper }
          })
          map.addLayer({
            id: 'library-points',
            type: 'circle',
            source: 'libraries',
            filter: ['!', ['has', 'point_count']],
            paint: {
              'circle-color': ['case', ['get', 'closed'], muted, primary],
              'circle-radius': 7,
              'circle-stroke-width': 2,
              'circle-stroke-color': paper
            }
          })
          map.addSource('search-location', {
            type: 'geojson',
            data: { type: 'FeatureCollection', features: [] }
          })
          map.addLayer({
            id: 'search-location',
            type: 'circle',
            source: 'search-location',
            paint: {
              'circle-color': colors.getPropertyValue('--brand-forest').trim(),
              'circle-radius': 9,
              'circle-stroke-width': 3,
              'circle-stroke-color': paper
            }
          })
          map.on('click', 'library-clusters', async (event) => {
            const feature = event.features?.[0]
            if (!feature || feature.geometry.type !== 'Point') return
            const source = map.getSource('libraries')
            const zoom = await source
              .getClusterExpansionZoom(Number(feature.properties.cluster_id))
              .catch(() => null)
            if (zoom !== null && this.isConnected && this.map === map)
              map.easeTo({
                center: feature.geometry.coordinates,
                zoom,
                duration: 500,
                essential: true
              })
          })
          map.on('click', 'library-points', (event) => {
            const feature = event.features?.[0]
            if (!feature || feature.geometry.type !== 'Point') return
            const props = feature.properties || {}
            this.showLibraryPopup(props, feature.geometry.coordinates)
            this.dispatchEvent(
              new CustomEvent('library-map-point-clicked', {
                bubbles: true,
                detail: { name: props.name, url: props.url }
              })
            )
          })
          for (const layer of ['library-clusters', 'library-points']) {
            map.on('mouseenter', layer, () => {
              map.getCanvas().style.cursor = 'pointer'
            })
            map.on('mouseleave', layer, () => {
              map.getCanvas().style.cursor = ''
            })
          }
          this.updateMap({ isInitial: true })
          if (this.pendingSelect) {
            this.selectLibrary(this.pendingSelect)
            this.pendingSelect = null
          }
        })
      } catch {
        clearTimeout(loadingTimer)
        this.setStatus(
          'The map is unavailable in this browser. Library details and listings remain available.'
        )
      }
    }

    showLibraryPopup(props, coordinates) {
      if (!this.map || !this.PopupClass || !coordinates) return
      const pinSvg =
        '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>'
      const arrowSvg =
        '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>'

      const content = document.createElement('div')
      content.className = 'map-popup-card map-popup-library'

      const header = document.createElement('header')
      header.className = 'map-popup-header'

      const badges = document.createElement('div')
      badges.className = 'map-popup-badges'

      if (props.closed) {
        const closedBadge = document.createElement('span')
        closedBadge.className = 'status-pill status-pill--closed'
        const dot = document.createElement('span')
        dot.className = 'status-pill-dot'
        dot.setAttribute('aria-hidden', 'true')
        const text = document.createElement('span')
        text.textContent = 'Permanently closed'
        closedBadge.append(dot, text)
        badges.appendChild(closedBadge)
      }
      if (props.authority) {
        const authBadge = document.createElement('span')
        authBadge.className = 'status-pill status-pill--plum'
        const text = document.createElement('span')
        text.textContent = String(props.authority).replace(/-/g, ' ')
        authBadge.appendChild(text)
        badges.appendChild(authBadge)
      }
      if (badges.hasChildNodes()) {
        header.appendChild(badges)
      }

      const title = document.createElement('h3')
      title.className = 'map-popup-title'
      if (props.url) {
        const link = document.createElement('a')
        link.href = String(props.url)
        link.textContent = String(props.name || 'Library')
        title.appendChild(link)
      } else {
        title.textContent = String(props.name || 'Library')
      }
      header.appendChild(title)
      content.appendChild(header)

      if (props.address) {
        const addr = document.createElement('p')
        addr.className = 'map-popup-address'
        addr.innerHTML = `${pinSvg}<span>${props.address}</span>`
        content.appendChild(addr)
      }

      if (props.url) {
        const footer = document.createElement('footer')
        footer.className = 'map-popup-footer'
        const link = document.createElement('a')
        link.href = String(props.url)
        link.className = 'map-popup-action'
        link.innerHTML = `<span>View library details</span>${arrowSvg}`
        footer.appendChild(link)
        content.appendChild(footer)
      }

      this.removePopup()
      this.popup = new this.PopupClass({
        maxWidth: '320px',
        closeButton: true,
        focusAfterOpen: false
      })
        .setLngLat(coordinates)
        .setDOMContent(content)
        .addTo(this.map)

      this.onPopupClose = () => {
        if (this.isProgrammaticPopupClose) return
        this.popup = null
        this.dispatchEvent(new CustomEvent('library-map-popup-closed', { bubbles: true }))
      }
      this.popup.on('close', this.onPopupClose)
    }

    selectLibrary(library) {
      if (!this.map) {
        this.pendingSelect = library
        return
      }
      const lng = Number(library.longitude)
      const lat = Number(library.latitude)
      if (!Number.isFinite(lng) || !Number.isFinite(lat)) return

      this.removePopup()

      const prefersReduced =
        typeof window !== 'undefined' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches

      this.map.flyTo({
        center: [lng, lat],
        zoom: 16,
        duration: prefersReduced ? 0 : 800,
        essential: true
      })

      const props = {
        name: library.name,
        address: library.address || library.postcode || '',
        authority: library.authorityName || library.authority || '',
        url: library.url ? sitePath(library.url) : '',
        closed: Boolean(
          library.closed ||
          library.permanentlyClosed ||
          library.facilityOperated === 'Closed' ||
          library.facilityOperated === 'Facility Not Open'
        )
      }
      this.showLibraryPopup(props, [lng, lat])
    }

    fitAllBounds() {
      if (!this.map) return
      const originPoints = this.location ? [[this.location.longitude, this.location.latitude]] : []
      const points = [
        ...(this.data?.features || []).map((f) => f.geometry?.coordinates),
        ...originPoints
      ].filter(Boolean)
      const prefersReduced =
        typeof window !== 'undefined' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (points.length === 1) {
        this.map.flyTo({
          center: points[0],
          zoom: 15.5,
          duration: prefersReduced ? 0 : 700,
          essential: true
        })
      } else if (points.length > 1) {
        const longitudes = points.map(([lng]) => lng)
        const latitudes = points.map(([, lat]) => lat)
        this.map.fitBounds(
          [
            [Math.min(...longitudes), Math.min(...latitudes)],
            [Math.max(...longitudes), Math.max(...latitudes)]
          ],
          { padding: 48, maxZoom: 14, duration: prefersReduced ? 0 : 700, essential: true }
        )
      }
    }

    updateMap({ isInitial = false } = {}) {
      this.dataset.mapCount = String(this.data.features.length)
      const source = this.map?.getSource('libraries')
      if (!this.map || !source) return
      this.removePopup()
      source.setData(this.data)
      const origin = {
        type: 'FeatureCollection',
        features: this.location
          ? [
              {
                type: 'Feature',
                properties: {},
                geometry: {
                  type: 'Point',
                  coordinates: [this.location.longitude, this.location.latitude]
                }
              }
            ]
          : []
      }
      this.map.getSource('search-location')?.setData(origin)
      const points = [...this.data.features, ...origin.features].map(
        (feature) => feature.geometry.coordinates
      )
      const prefersReduced =
        typeof window !== 'undefined' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (points.length === 1) {
        if (isInitial || prefersReduced) {
          this.map.jumpTo({ center: points[0], zoom: 15.5 })
        } else {
          this.map.flyTo({
            center: points[0],
            zoom: 15.5,
            duration: 900,
            essential: true
          })
        }
      } else if (points.length > 1) {
        const longitudes = points.map(([longitude]) => longitude)
        const latitudes = points.map(([, latitude]) => latitude)
        const bounds = [
          [Math.min(...longitudes), Math.min(...latitudes)],
          [Math.max(...longitudes), Math.max(...latitudes)]
        ]
        this.map.fitBounds(bounds, {
          padding: 48,
          maxZoom: 14,
          duration: isInitial || prefersReduced ? 0 : 900,
          essential: true
        })
      }
      this.setStatus(this.data.features.length ? '' : this.dataset.emptyMessage)
      this.dataset.mapReady = 'true'
    }
  }

  if (!customElements.get('library-map')) customElements.define('library-map', LibraryMap)
</script>
