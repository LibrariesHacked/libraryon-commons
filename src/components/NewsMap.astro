---
import 'maplibre-gl/dist/maplibre-gl.css'

const {
  id = `news-map-${crypto.randomUUID()}`,
  stories = [],
  label = 'News story locations',
  emptyMessage = 'No mapped news stories to display for these filters.'
} = Astro.props

function storiesToLocationGeoJson(items) {
  const locMap = new Map()
  for (const s of items) {
    if (s.recent_stories && Array.isArray(s.recent_stories)) {
      const lat4 = Math.round(Number(s.lat) * 1e4) / 1e4
      const lng4 = Math.round(Number(s.lng) * 1e4) / 1e4
      const key = `${lat4},${lng4}`
      locMap.set(key, {
        id: s.id || key,
        name: s.name || s.authority_name || 'News location',
        authority_name: s.authority_name || '',
        country: s.country || '',
        lat: lat4,
        lng: lng4,
        story_count: s.story_count || s.recent_stories.length,
        stories: s.recent_stories
      })
      continue
    }

    if (typeof s.lat === 'number' && typeof s.lng === 'number' && !isNaN(s.lat) && !isNaN(s.lng)) {
      const lat4 = Math.round(s.lat * 1e4) / 1e4
      const lng4 = Math.round(s.lng * 1e4) / 1e4
      const key = `${lat4},${lng4}`
      if (!locMap.has(key)) {
        locMap.set(key, {
          id: s.authority_name || s.entity || key,
          name: s.authority_name || s.entity || 'News location',
          authority_name: s.authority_name || '',
          country: s.country || '',
          lat: lat4,
          lng: lng4,
          story_count: 0,
          stories: []
        })
      }
      const loc = locMap.get(key)
      loc.story_count += 1
      if (loc.stories.length < 15) {
        loc.stories.push({
          id: s.id,
          date: s.date || '',
          entity: s.entity || s.authority_name || 'News update',
          text: (s.text || '').length > 180 ? `${(s.text || '').slice(0, 177)}...` : s.text || '',
          url: s.url || '',
          domain: s.domain || '',
          category: (s.categories && s.categories[0]) || '',
          change: s.change_type || ''
        })
      }
    }
  }

  const features = []
  for (const loc of locMap.values()) {
    features.push({
      type: 'Feature',
      geometry: {
        type: 'Point',
        coordinates: [loc.lng, loc.lat]
      },
      properties: {
        id: loc.id,
        name: loc.name,
        authority_name: loc.authority_name,
        country: loc.country,
        story_count: loc.story_count,
        stories: JSON.stringify(loc.stories)
      }
    })
  }
  return {
    type: 'FeatureCollection',
    features
  }
}

const data = storiesToLocationGeoJson(stories)
---

<news-map
  id={id}
  class="news-map-wrapper"
  role="region"
  aria-label={label}
  data-empty-message={emptyMessage}
>
  <div class="news-map-canvas" data-map-canvas></div>
  <p class="news-map-status" data-map-status role="status" hidden>
    Loading map...
  </p>
  <div class="news-map-legend" aria-hidden="true">
    <span class="legend-item legend-item--cluster">
      <span class="legend-dot legend-dot--cluster"></span>
      <span>Area cluster</span>
    </span>
    <span class="legend-item legend-item--location">
      <span class="legend-dot legend-dot--location"></span>
      <span>Location (stories)</span>
    </span>
  </div>
  <script
    type="application/json"
    data-map-data
    set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
  />
  <noscript>
    <p class="notice">
      The interactive map requires JavaScript. News listings remain available on this page.
    </p>
  </noscript>
</news-map>

<script>
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'

  function storiesToLocationGeoJson(items) {
    const locMap = new Map()
    for (const s of items) {
      if (s.recent_stories && Array.isArray(s.recent_stories)) {
        const lat4 = Math.round(Number(s.lat) * 1e4) / 1e4
        const lng4 = Math.round(Number(s.lng) * 1e4) / 1e4
        const key = `${lat4},${lng4}`
        locMap.set(key, {
          id: s.id || key,
          name: s.name || s.authority_name || 'News location',
          authority_name: s.authority_name || '',
          country: s.country || '',
          lat: lat4,
          lng: lng4,
          story_count: s.story_count || s.recent_stories.length,
          stories: s.recent_stories
        })
        continue
      }

      if (
        typeof s.lat === 'number' &&
        typeof s.lng === 'number' &&
        !isNaN(s.lat) &&
        !isNaN(s.lng)
      ) {
        const lat4 = Math.round(s.lat * 1e4) / 1e4
        const lng4 = Math.round(s.lng * 1e4) / 1e4
        const key = `${lat4},${lng4}`
        if (!locMap.has(key)) {
          locMap.set(key, {
            id: s.authority_name || s.entity || key,
            name: s.authority_name || s.entity || 'News location',
            authority_name: s.authority_name || '',
            country: s.country || '',
            lat: lat4,
            lng: lng4,
            story_count: 0,
            stories: []
          })
        }
        const loc = locMap.get(key)
        loc.story_count += 1
        if (loc.stories.length < 15) {
          loc.stories.push({
            id: s.id,
            date: s.date || '',
            entity: s.entity || s.authority_name || 'News update',
            text: (s.text || '').length > 180 ? `${(s.text || '').slice(0, 177)}...` : s.text || '',
            url: s.url || '',
            domain: s.domain || '',
            category: (s.categories && s.categories[0]) || '',
            change: s.change_type || ''
          })
        }
      }
    }

    const features = []
    for (const loc of locMap.values()) {
      features.push({
        type: 'Feature',
        geometry: {
          type: 'Point',
          coordinates: [loc.lng, loc.lat]
        },
        properties: {
          id: loc.id,
          name: loc.name,
          authority_name: loc.authority_name,
          country: loc.country,
          story_count: loc.story_count,
          stories: JSON.stringify(loc.stories)
        }
      })
    }
    return { type: 'FeatureCollection', features }
  }

  class NewsMap extends HTMLElement {
    map = undefined
    popup = undefined
    observer = undefined
    data = { type: 'FeatureCollection', features: [] }
    initializing = false
    lifetime = undefined

    connectedCallback() {
      if (this.lifetime && !this.lifetime.signal.aborted) return
      this.lifetime = new AbortController()
      const { signal } = this.lifetime

      if (!this.dataset.initialized) {
        const raw = this.querySelector('[data-map-data]')?.textContent
        if (raw) {
          try {
            this.data = JSON.parse(raw)
          } catch (e) {
            console.error('Failed parsing map data', e)
          }
        }
      }
      this.dataset.initialized = 'true'

      this.addEventListener(
        'news-map-update',
        (event) => {
          const { stories = [] } = event.detail
          this.data = storiesToLocationGeoJson(stories)
          this.updateMap({ isInitial: false })
        },
        { signal }
      )

      const rect = this.getBoundingClientRect()
      const inView =
        typeof window !== 'undefined' && rect.top < window.innerHeight + 400 && rect.bottom > -400
      if (inView) {
        this.initializeMap(signal)
      } else {
        this.observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return
            this.observer?.disconnect()
            this.initializeMap(signal)
          },
          { rootMargin: '400px' }
        )
        this.observer.observe(this)
      }
    }

    disconnectedCallback() {
      this.lifetime?.abort()
      this.observer?.disconnect()
      this.popup?.remove()
      this.map?.remove()
      this.map = undefined
      this.initializing = false
      delete this.dataset.mapReady
    }

    setStatus(message = '') {
      const status = this.querySelector('[data-map-status]')
      if (!status) return
      status.textContent = message
      status.hidden = !message
    }

    async initializeMap(signal) {
      if (this.map || this.initializing) return
      this.initializing = true

      const loadingTimer = setTimeout(() => {
        if (!this.dataset.mapReady) this.setStatus('Loading map...')
      }, 300)

      try {
        const { Map, NavigationControl, FullscreenControl, ScaleControl, Popup, setWorkerUrl } =
          await import('maplibre-gl')
        if (!this.isConnected || signal.aborted) {
          clearTimeout(loadingTimer)
          return
        }
        setWorkerUrl(workerUrl)

        const points = (this.data?.features || [])
          .map((f) => f.geometry?.coordinates)
          .filter(Boolean)
        const cameraOptions = {
          center: [-3.5, 54.5],
          zoom: 5
        }

        if (points.length === 1) {
          cameraOptions.center = points[0]
          cameraOptions.zoom = 10
        } else if (points.length > 1) {
          const lngs = points.map(([lng]) => lng)
          const lats = points.map(([, lat]) => lat)
          cameraOptions.bounds = [
            [Math.min(...lngs), Math.min(...lats)],
            [Math.max(...lngs), Math.max(...lats)]
          ]
          cameraOptions.fitBoundsOptions = { padding: 40, maxZoom: 11 }
        }

        const map = new Map({
          container: this.querySelector('[data-map-canvas]'),
          style: 'https://tiles.openfreemap.org/styles/positron',
          ...cameraOptions,
          renderWorldCopies: false,
          cooperativeGestures: false
        })
        this.map = map

        map.addControl(new NavigationControl(), 'top-right')
        map.addControl(new FullscreenControl(), 'top-right')
        map.addControl(new ScaleControl({ unit: 'imperial' }))

        map.on('error', () => {
          clearTimeout(loadingTimer)
          this.setStatus('Map tiles could not be loaded. News stories remain accessible.')
        })

        map.on('load', () => {
          clearTimeout(loadingTimer)
          const colors = getComputedStyle(this)
          const primary = colors.getPropertyValue('--brand-primary').trim() || '#671e7d'
          const forest = colors.getPropertyValue('--brand-forest').trim() || '#0d522b'
          const roseSoft = colors.getPropertyValue('--line-rose-soft').trim() || '#e6c0c8'
          const paper = colors.getPropertyValue('--paper').trim() || '#ffffff'
          const ink = colors.getPropertyValue('--ink').trim() || '#1e1a28'

          map.addSource('news-points', {
            type: 'geojson',
            data: this.data,
            cluster: true,
            clusterRadius: 40,
            clusterMaxZoom: 11
          })

          // 1. Regional Area Clusters (Forest Green)
          map.addLayer({
            id: 'news-clusters',
            type: 'circle',
            source: 'news-points',
            filter: ['has', 'point_count'],
            paint: {
              'circle-color': forest,
              'circle-radius': ['step', ['get', 'point_count'], 18, 10, 22, 50, 28],
              'circle-stroke-width': 3,
              'circle-stroke-color': paper
            }
          })

          map.addLayer({
            id: 'news-cluster-count',
            type: 'symbol',
            source: 'news-points',
            filter: ['has', 'point_count'],
            layout: {
              'text-field': '{point_count_abbreviated}',
              'text-font': ['Noto Sans Regular'],
              'text-size': 12
            },
            paint: { 'text-color': paper }
          })

          // 2. Individual Location Markers (Brand Plum with story count)
          map.addLayer({
            id: 'news-location-points',
            type: 'circle',
            source: 'news-points',
            filter: ['!', ['has', 'point_count']],
            paint: {
              'circle-color': primary,
              'circle-radius': [
                'interpolate',
                ['linear'],
                ['get', 'story_count'],
                1,
                13,
                20,
                16,
                100,
                20,
                500,
                24
              ],
              'circle-stroke-width': 2.5,
              'circle-stroke-color': roseSoft
            }
          })

          map.addLayer({
            id: 'news-location-counts',
            type: 'symbol',
            source: 'news-points',
            filter: ['!', ['has', 'point_count']],
            layout: {
              'text-field': ['to-string', ['get', 'story_count']],
              'text-font': ['Noto Sans Regular'],
              'text-size': 11
            },
            paint: { 'text-color': paper }
          })

          // 3. Location Place Name Labels
          map.addLayer({
            id: 'news-location-names',
            type: 'symbol',
            source: 'news-points',
            minzoom: 8,
            filter: ['!', ['has', 'point_count']],
            layout: {
              'text-field': ['get', 'name'],
              'text-font': ['Noto Sans Regular'],
              'text-size': 11,
              'text-offset': [0, 1.4],
              'text-anchor': 'top'
            },
            paint: {
              'text-color': ink,
              'text-halo-color': paper,
              'text-halo-width': 1.5
            }
          })

          // Cluster click -> zoom in smoothly
          map.on('click', 'news-clusters', async (event) => {
            const feature = event.features?.[0]
            if (!feature || feature.geometry.type !== 'Point') return
            const source = map.getSource('news-points')
            const zoom = await source
              .getClusterExpansionZoom(Number(feature.properties.cluster_id))
              .catch(() => null)
            if (zoom !== null && this.isConnected && this.map === map) {
              map.easeTo({
                center: feature.geometry.coordinates,
                zoom,
                duration: 500,
                essential: true
              })
            }
          })

          const calendarSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>'
          const arrowSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>'
          const chevronLeftSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>'
          const chevronRightSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>'

          // Location click -> interactive story pager popup
          map.on('click', 'news-location-points', (event) => {
            const feature = event.features?.[0]
            if (!feature || feature.geometry.type !== 'Point') return
            const props = feature.properties || {}
            let stories = []
            try {
              stories = JSON.parse(props.stories || '[]')
            } catch {
              stories = []
            }

            const content = document.createElement('div')
            content.className = 'map-popup-card map-popup-location'

            const header = document.createElement('header')
            header.className = 'map-popup-header'

            const changeTypeLabels = {
              closure: 'Closure',
              reduction_or_cut: 'Reduction or Cut',
              community_handover: 'Community Handover',
              investment_or_expansion: 'Investment or Expansion',
              unstaffed_open_plus: 'Unstaffed Open+',
              other: 'Sector Change'
            }
            const categoryLabels = {
              cuts_and_finance: 'Cuts & Finance',
              closures_and_threats: 'Closures & Threats',
              staffing_and_unions: 'Staffing & Unions',
              events_and_activities: 'Events & Activities',
              campaigns_and_protests: 'Campaigns & Protests',
              volunteers_and_community: 'Volunteers & Community',
              digital_and_technology: 'Digital & Technology',
              refurbishment_and_new_builds: 'Refurbishment & Builds',
              opening_hours: 'Opening Hours',
              book_bans_and_challenges: 'Book Bans',
              mobile_and_outreach: 'Mobile & Outreach',
              governance_and_trusts: 'Governance & Trusts',
              co_location: 'Co-location & Hubs',
              warm_spaces_and_wellbeing: 'Warm Spaces',
              unstaffed_open_plus: 'Unstaffed Open+'
            }

            const badges = document.createElement('div')
            badges.className = 'map-popup-badges'

            const countBadge = document.createElement('span')
            countBadge.className = 'status-pill status-pill--plum'
            const dot = document.createElement('span')
            dot.className = 'status-pill-dot'
            dot.setAttribute('aria-hidden', 'true')
            const countNum = Number(props.story_count) || stories.length
            const countText = document.createElement('span')
            countText.textContent = `${countNum} ${countNum === 1 ? 'story' : 'stories'}`
            countBadge.append(dot, countText)
            badges.appendChild(countBadge)

            if (props.country) {
              const countryBadge = document.createElement('span')
              countryBadge.className = 'status-pill status-pill--apricot'
              countryBadge.textContent = String(props.country)
              badges.appendChild(countryBadge)
            }
            header.appendChild(badges)

            const title = document.createElement('h3')
            title.className = 'map-popup-title'
            title.textContent = String(props.name || 'Library news location')
            header.appendChild(title)
            content.appendChild(header)

            const storyViewport = document.createElement('div')
            storyViewport.className = 'map-popup-story-viewport'
            content.appendChild(storyViewport)

            let currentIndex = 0

            const renderStory = (idx) => {
              storyViewport.innerHTML = ''
              const s = stories[idx]
              if (!s) return

              const metaRow = document.createElement('div')
              metaRow.className = 'map-popup-meta-row'

              if (s.date) {
                const dateSpan = document.createElement('span')
                dateSpan.className = 'map-popup-date'
                dateSpan.innerHTML = `${calendarSvg}<span>${s.date}</span>`
                metaRow.appendChild(dateSpan)
              }

              if (s.change) {
                const changeBadge = document.createElement('span')
                changeBadge.className = 'status-pill status-pill--rose'
                changeBadge.textContent = changeTypeLabels[s.change] || String(s.change)
                metaRow.appendChild(changeBadge)
              } else if (s.category) {
                const catBadge = document.createElement('span')
                catBadge.className = 'status-pill status-pill--green'
                catBadge.textContent =
                  categoryLabels[s.category] || String(s.category).replace(/_/g, ' ')
                metaRow.appendChild(catBadge)
              }
              storyViewport.appendChild(metaRow)

              if (s.entity && s.entity !== props.name) {
                const entityP = document.createElement('p')
                entityP.className = 'map-popup-entity-name'
                entityP.textContent = s.entity
                storyViewport.appendChild(entityP)
              }

              if (s.text) {
                const snippet = document.createElement('p')
                snippet.className = 'map-popup-text'
                snippet.textContent = String(s.text)
                storyViewport.appendChild(snippet)
              }

              if (s.url) {
                const link = document.createElement('a')
                link.href = String(s.url)
                link.target = '_blank'
                link.rel = 'noopener noreferrer'
                link.className = 'map-popup-action'
                const label = s.domain ? `Read at ${s.domain}` : 'Read source article'
                link.innerHTML = `<span>${label}</span>${arrowSvg}`
                storyViewport.appendChild(link)
              }
            }

            if (stories.length > 1) {
              const navBar = document.createElement('div')
              navBar.className = 'map-popup-nav'

              const prevBtn = document.createElement('button')
              prevBtn.type = 'button'
              prevBtn.className = 'map-popup-nav-btn'
              prevBtn.setAttribute('aria-label', 'Previous story')
              prevBtn.innerHTML = chevronLeftSvg

              const counter = document.createElement('span')
              counter.className = 'map-popup-counter'
              counter.textContent = `1 of ${stories.length}`

              const nextBtn = document.createElement('button')
              nextBtn.type = 'button'
              nextBtn.className = 'map-popup-nav-btn'
              nextBtn.setAttribute('aria-label', 'Next story')
              nextBtn.innerHTML = chevronRightSvg

              prevBtn.addEventListener('click', (e) => {
                e.stopPropagation()
                currentIndex = (currentIndex - 1 + stories.length) % stories.length
                counter.textContent = `${currentIndex + 1} of ${stories.length}`
                renderStory(currentIndex)
              })

              nextBtn.addEventListener('click', (e) => {
                e.stopPropagation()
                currentIndex = (currentIndex + 1) % stories.length
                counter.textContent = `${currentIndex + 1} of ${stories.length}`
                renderStory(currentIndex)
              })

              navBar.append(prevBtn, counter, nextBtn)
              content.appendChild(navBar)
            }

            renderStory(0)

            const footer = document.createElement('footer')
            footer.className = 'map-popup-footer'
            const filterBtn = document.createElement('button')
            filterBtn.type = 'button'
            filterBtn.className = 'map-popup-filter-btn'
            filterBtn.textContent = 'Filter stories in list ↓'
            filterBtn.addEventListener('click', () => {
              this.dispatchEvent(
                new CustomEvent('news-select-location', {
                  bubbles: true,
                  detail: { authority: props.authority_name || props.name }
                })
              )
            })
            footer.appendChild(filterBtn)
            content.appendChild(footer)

            this.popup?.remove()
            this.popup = new Popup({ maxWidth: '340px', closeButton: true })
              .setLngLat(feature.geometry.coordinates)
              .setDOMContent(content)
              .addTo(map)
          })

          for (const layer of ['news-clusters', 'news-location-points']) {
            map.on('mouseenter', layer, () => {
              map.getCanvas().style.cursor = 'pointer'
            })
            map.on('mouseleave', layer, () => {
              map.getCanvas().style.cursor = ''
            })
          }

          this.dataset.mapReady = 'true'
          this.setStatus('')
          this.updateMap({ isInitial: true })
        })
      } catch (e) {
        clearTimeout(loadingTimer)
        console.error('Failed initializing news map', e)
        this.setStatus('Error initializing map.')
      }
    }

    updateMap({ isInitial = false } = {}) {
      if (!this.map || !this.dataset.mapReady) return
      const source = this.map.getSource('news-points')
      if (source && typeof source.setData === 'function') {
        source.setData(this.data)
      }

      const points = (this.data?.features || []).map((f) => f.geometry?.coordinates).filter(Boolean)

      if (points.length === 0) {
        this.setStatus(this.dataset.emptyMessage || 'No mapped stories for this filter.')
        return
      }
      this.setStatus('')

      if (!isInitial) {
        if (points.length === 1) {
          this.map.easeTo({
            center: points[0],
            zoom: 10,
            duration: 600,
            essential: true
          })
        } else if (points.length > 1) {
          const lngs = points.map(([lng]) => lng)
          const lats = points.map(([, lat]) => lat)
          this.map.fitBounds(
            [
              [Math.min(...lngs), Math.min(...lats)],
              [Math.max(...lngs), Math.max(...lats)]
            ],
            { padding: 40, maxZoom: 11, duration: 600 }
          )
        }
      }
    }
  }

  if (typeof customElements !== 'undefined' && !customElements.get('news-map')) {
    customElements.define('news-map', NewsMap)
  }
</script>
