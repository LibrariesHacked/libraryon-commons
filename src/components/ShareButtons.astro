---
import { Share2, Link as LinkIcon, Check, Mail } from '@lucide/astro'
import { canonicalInternalPath, settings } from '../lib/site/siteHelpers.mjs'
import { absoluteUrl, buildShareUrls } from '../lib/site/seoHelpers.mjs'

const {
  title = settings.site.title,
  description = settings.site.description,
  url,
  heading = 'Share this page',
  class: className
} = Astro.props

const siteBase = Astro.site ? Astro.site.href : settings.site.url
const pageUrl =
  url ||
  (Astro.site
    ? new URL(canonicalInternalPath(Astro.url.pathname), Astro.site).href
    : absoluteUrl(canonicalInternalPath(Astro.url.pathname), siteBase))

const shareUrls = buildShareUrls({ url: pageUrl, title, description })
---

<section
  class:list={['share-section', className]}
  aria-label={heading}
  data-share-container
  data-share-url={pageUrl}
  data-share-title={title}
  data-share-description={description}
>
  <div class="share-header">
    <h2 class="share-heading">{heading}</h2>
  </div>

  <div class="share-actions">
    <button
      type="button"
      class="share-btn share-btn-primary"
      data-share-action="native"
      hidden
      aria-label="Share via device options"
    >
      <Share2 size={15} aria-hidden="true" />
      <span>Share...</span>
    </button>

    <button
      type="button"
      class="share-btn share-btn-copy"
      data-share-action="copy"
      aria-label="Copy page link to clipboard"
    >
      <span class="share-icon-copy">
        <LinkIcon size={15} aria-hidden="true" />
      </span>
      <span class="share-icon-check" hidden>
        <Check size={15} aria-hidden="true" />
      </span>
      <span class="share-btn-label">Copy link</span>
      <span class="share-feedback" hidden>
        Link copied!
      </span>
    </button>

    <a href={shareUrls.email} class="share-btn share-link" aria-label="Share via email">
      <Mail size={15} aria-hidden="true" />
      <span>Email</span>
    </a>

    <a
      href={shareUrls.linkedin}
      class="share-btn share-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Share on LinkedIn (opens in new tab)"
    >
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.4 1.4 0 1 0 0-2.8 1.4 1.4 0 0 0 0 2.8m1.4 9.74v-8.37H5.06v8.37h2.8z"></path>
      </svg>
      <span>LinkedIn</span>
    </a>

    <a
      href={shareUrls.facebook}
      class="share-btn share-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Share on Facebook (opens in new tab)"
    >
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
      </svg>
      <span>Facebook</span>
    </a>
  </div>
</section>

<script src="../scripts/shareClient.mjs"></script>

<style>
  .share-section {
    margin-block: var(--size-7) var(--size-5);
    padding: var(--size-4) var(--size-5);
    background: var(--surface-tint-plum);
    border-radius: var(--card-radius);
    border: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--size-3) var(--size-4);
  }

  .share-header {
    display: flex;
    align-items: center;
  }

  .share-heading {
    margin: 0;
    font-family: var(--font);
    font-size: var(--font-size-1);
    font-weight: var(--font-weight-6);
    color: var(--ink);
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--size-2);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 34px;
    height: 34px;
    box-sizing: border-box;
    padding: 0 0.85rem;
    font-family: var(--font);
    font-size: 0.82rem;
    font-weight: var(--font-weight-6);
    line-height: 1;
    color: var(--brand-link);
    background: var(--paper);
    border: 0;
    border-radius: 999px;
    box-shadow: 0 1px 3px rgba(30, 26, 40, 0.08);
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s var(--motion-ease),
      color 0.15s var(--motion-ease),
      box-shadow 0.15s var(--motion-ease);
  }

  .share-btn:hover {
    background: var(--surface-tint-plum-selected);
    color: var(--brand-primary);
    box-shadow: 0 2px 6px rgba(30, 26, 40, 0.12);
  }

  .share-btn:focus-visible {
    outline: var(--border-size-2) solid var(--focus);
    outline-offset: 2px;
  }

  .share-btn.is-copied {
    background: var(--surface-tint-green);
    color: var(--brand-forest);
  }

  .share-btn-primary {
    background: var(--brand-primary);
    color: var(--paper);
  }

  .share-btn-primary:hover {
    background: var(--brand-link);
    color: var(--paper);
  }

  .share-icon-copy,
  .share-icon-check {
    display: inline-flex;
    align-items: center;
  }
</style>
