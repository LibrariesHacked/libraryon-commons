---
/** @fileoverview Render accessible site navigation with active-page and active-section states. */
import { ChevronDown, ChevronRight } from '@lucide/astro'
import { safeURL, settings } from '../lib/site/siteHelpers.mjs'

const { items = [], mode = 'desktop' } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'

/**
 * Normalize an internal path for consistent navigation-state comparisons.
 * @param {string} value - Candidate path from navigation data.
 * @returns {string} Normalized path, or an empty string for unsupported paths.
 */
function normalizedPath(value) {
  if (!value?.startsWith('/') || value.startsWith('//')) return ''
  return value.replace(/\/+$/, '') || '/'
}

/**
 * Check whether a navigation path is the current page or one of its parent sections.
 * @param {string} value - Candidate navigation path.
 * @returns {boolean} Whether the current page belongs to this path.
 */
function isActive(value) {
  const path = normalizedPath(value)
  return path && (currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`)))
}

/**
 * Check whether a navigation path exactly matches the current page.
 * @param {string} value - Candidate navigation path.
 * @returns {boolean} Whether the path is the current page.
 */
function isCurrent(value) {
  return currentPath === normalizedPath(value)
}
---

<ul class:list={['navigation-items', `navigation-items-${mode}`]}>
  {items.map((item) => {
    const children = (item.children || []).filter((child) => safeURL(child.url))
    const href = safeURL(item.url)
    const childActive = children.some((child) => isActive(child.url))
    return (
      <li class="navigation-item">
        {children.length > 0 ? (
          <details
            class:list={['nav-dropdown', { 'has-current': childActive || isActive(item.url) }]}
          >
            <summary data-current={childActive || isActive(item.url) ? 'true' : undefined}>
              {item.label}
              <ChevronDown size={15} aria-hidden="true" />
            </summary>
            <div class="nav-dropdown-panel">
              {href && (
                <a
                  class="nav-dropdown-overview"
                  href={href}
                  aria-current={isCurrent(item.url) ? 'page' : undefined}
                >
                  {item.label} {settings.ui.navigation.overview_link}{' '}
                  <ChevronRight size={15} aria-hidden="true" />
                </a>
              )}
              {children.map((child) => (
                <a
                  href={safeURL(child.url)}
                  aria-current={isCurrent(child.url) ? 'page' : undefined}
                >
                  <span>{child.label}</span>
                  {child.description && <small>{child.description}</small>}
                </a>
              ))}
            </div>
          </details>
        ) : (
          href && (
            <a href={href} aria-current={isCurrent(item.url) ? 'page' : undefined}>
              {item.label}
            </a>
          )
        )}
      </li>
    )
  })}
</ul>
