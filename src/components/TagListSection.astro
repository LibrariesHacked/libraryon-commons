---
import {
  Accessibility,
  Archive,
  ArrowUpDown,
  ArrowUpRight,
  Baby,
  BookOpen,
  Briefcase,
  Building,
  Calendar,
  Car,
  CircleCheck,
  Coffee,
  DoorOpen,
  Ear,
  GraduationCap,
  Heart,
  HeartPulse,
  Info,
  Landmark,
  Mail,
  Monitor,
  Printer,
  Scan,
  Shield,
  Sparkles,
  TreePine,
  Truck,
  Users,
  Wifi,
  Wrench
} from '@lucide/astro'
import facilityIcons from '../data/facility-icons.json'
import { safeURL } from '../lib/helpers/siteHelpers.mjs'

const iconComponents = {
  Accessibility,
  Archive,
  ArrowUpDown,
  Baby,
  BookOpen,
  Briefcase,
  Building,
  Calendar,
  Car,
  CircleCheck,
  Coffee,
  DoorOpen,
  Ear,
  GraduationCap,
  Heart,
  HeartPulse,
  Info,
  Landmark,
  Mail,
  Monitor,
  Printer,
  Scan,
  Shield,
  Sparkles,
  TreePine,
  Truck,
  Users,
  Wifi,
  Wrench
}

const {
  heading,
  items = [],
  mode = 'display',
  tagGroup,
  initialVisible,
  viewAllLabel = 'View all'
} = Astro.props

const validItems = items.filter(
  (item) =>
    item && (typeof item === 'string' ? item.trim() : item.label || item.service || item.value)
)

const fallbackColors = ['plum', 'rose', 'green', 'apricot']

/**
 * Resolve the representative Lucide icon component and brand palette tint for a facility label.
 * Looks up matches in facility-icons.json without hardcoded conditional branches.
 *
 * @param {string} label - Facility or service name.
 * @param {number} index - Position index for fallback round-robin color distribution.
 * @returns {{ icon: any, color: string }} Icon component and color tint token name.
 */
function getFacilityDetails(label = '', index = 0) {
  const normalized = String(label).toLowerCase()

  for (const [iconName, config] of Object.entries(facilityIcons)) {
    if (config.matches.some((keyword) => normalized.includes(keyword))) {
      return {
        icon: iconComponents[iconName] || CircleCheck,
        color: config.color
      }
    }
  }

  return {
    icon: CircleCheck,
    color: fallbackColors[index % fallbackColors.length]
  }
}
---

{validItems.length > 0 && mode === 'select' && (
  <div class="filter-group">
    {heading && <p class="filter-group-heading">{heading}</p>}
    <div class="facility-chips filter-tag-list" data-tag-group={tagGroup}>
      {validItems.map((item, index) => {
        const label = typeof item === 'string' ? item : item.label || item.service || ''
        const value =
          typeof item === 'object' && item.value
            ? item.value
            : typeof item === 'object' && item.service
              ? item.service
              : label
        const { icon: IconComponent, color } = getFacilityDetails(label, index)
        const isExtra = typeof initialVisible === 'number' && index >= initialVisible
        return (
          <button
            type="button"
            class={`facility-chip facility-chip--${color} filter-tag`}
            data-service={tagGroup === 'services' ? value : undefined}
            data-accessibility={tagGroup === 'accessibility' ? value : undefined}
            data-extra-tag={isExtra ? 'true' : undefined}
            hidden={isExtra ? true : undefined}
            aria-pressed="false"
          >
            <span class="facility-chip-icon" aria-hidden="true">
              <IconComponent size={15} />
            </span>
            <span class="facility-chip-label">{label}</span>
          </button>
        )
      })}
      {typeof initialVisible === 'number' && validItems.length > initialVisible && (
        <button
          type="button"
          class="filter-tag-more"
          data-toggle-tags={tagGroup}
          data-expanded="false"
        >
          {viewAllLabel}
        </button>
      )}
    </div>
  </div>
)}

{validItems.length > 0 && mode !== 'select' && (
  <section class="detail-section facility-section">
    {heading && <h2>{heading}</h2>}
    <ul class="facility-chips">
      {validItems.map((item, index) => {
        const label = typeof item === 'string' ? item : item.label || item.service || ''
        const url = typeof item === 'object' && item.url ? safeURL(item.url) : null
        const { icon: IconComponent, color } = getFacilityDetails(label, index)
        return (
          <li class={`facility-chip facility-chip--${color}`}>
            <span class="facility-chip-icon" aria-hidden="true">
              <IconComponent size={15} />
            </span>
            {url ? (
              <a href={url} class="facility-chip-link">
                <span>{label}</span>
                <ArrowUpRight size={13} aria-hidden="true" />
              </a>
            ) : (
              <span class="facility-chip-label">{label}</span>
            )}
          </li>
        )
      })}
    </ul>
  </section>
)}
