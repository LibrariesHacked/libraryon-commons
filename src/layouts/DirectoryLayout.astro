---
import { BarChart3, Building, Globe, Library, Newspaper } from '@lucide/astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { directoryBreadcrumbs } from '../lib/directory/directoryHelpers.mjs'
import SiteLayout from './SiteLayout.astro'

const { title, description, subtitle, authority, tags = [], schema, image } = Astro.props
const breadcrumbs = directoryBreadcrumbs(title, authority)

const countryNames = [
  'england',
  'scotland',
  'wales',
  'northern ireland',
  'isle of man',
  'jersey',
  'guernsey'
]

const getHeroTagIcon = (tag = '') => {
  const lower = String(tag).toLowerCase()
  if (countryNames.some((country) => lower.includes(country))) return Globe
  if (lower.includes('activity') || lower.includes('impact')) return BarChart3
  if (lower.includes('news') || lower.includes('stor')) return Newspaper
  if (lower.includes('librar') || lower.includes('service')) return Library
  return Building
}
---

<SiteLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  schema={schema}
  image={image}
>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      {tags.length > 0 && (
        <ul class="tags hero-tags">
          {tags.map((tag) => {
            const label = typeof tag === 'object' && tag !== null ? tag.label : tag
            const href = typeof tag === 'object' && tag !== null ? tag.href : null
            const Icon = getHeroTagIcon(label)
            return (
              <li class="hero-tag">
                {href ? (
                  <a href={href} class="hero-tag-link">
                    <Icon size={14} class="hero-tag-icon" aria-hidden="true" />
                    <span>{label}</span>
                  </a>
                ) : (
                  <>
                    <Icon size={14} class="hero-tag-icon" aria-hidden="true" />
                    <span>{label}</span>
                  </>
                )}
              </li>
            )
          })}
        </ul>
      )}
    </div>
  </header>
  <section class="section shell detail-grid">
    <div>
      <slot />
    </div>
    <aside>
      <slot name="aside" />
    </aside>
  </section>
</SiteLayout>
