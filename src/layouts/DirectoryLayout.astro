---
import SiteLayout from './SiteLayout.astro';
import { ChevronRight } from '@lucide/astro';
import { settings, sitePath } from '../lib/site.mjs';
const { title, description, subtitle, authority, tags = [] } = Astro.props;
---

<SiteLayout title={title} description={description}>
  <header class="page-heading">
    <div class="shell">
      <nav class="breadcrumbs" aria-label={settings.ui.editorial.breadcrumb_aria_label}>
        <a href={sitePath('/libraries/')}>{settings.ui.directory.breadcrumb}</a>
        {authority && (
          <>
            <ChevronRight size={13} aria-hidden="true" />
            <a href={sitePath(`/libraries/${authority.slug}/`)}>{authority.name}</a>
          </>
        )}
      </nav>
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </header>
  <section class="section shell detail-grid">
    <div>
      <slot />
    </div>
    <aside>
      <slot name="aside" />
    </aside>
  </section>
</SiteLayout>
