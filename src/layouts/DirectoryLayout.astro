---
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { directoryBreadcrumbs } from '../lib/directory.mjs'
import SiteLayout from './SiteLayout.astro'
const { title, description, subtitle, authority, tags = [] } = Astro.props
const breadcrumbs = directoryBreadcrumbs(title, authority)
---

<SiteLayout title={title} description={description}>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </header>
  <section class="section shell detail-grid">
    <div>
      <slot />
    </div>
    <aside>
      <slot name="aside" />
    </aside>
  </section>
</SiteLayout>
