---
import Breadcrumbs from '../components/Breadcrumbs.astro'
import LibrarySearch from '../components/LibrarySearch.astro'
import { settings } from '../lib/site.mjs'
import SiteLayout from './SiteLayout.astro'
const { title, description, subtitle, authority, tags = [] } = Astro.props
const breadcrumbs = [
  { label: settings.ui.editorial.home_breadcrumb, href: '/' },
  { label: settings.ui.directory.breadcrumb, href: '/libraries/' },
  ...(authority ? [{ label: authority.name, href: `/libraries/${authority.slug}/` }] : []),
  { label: title, current: true }
]
---

<SiteLayout title={title} description={description}>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </header>
  <section class="section shell detail-grid">
    <div>
      <LibrarySearch />
      <slot />
    </div>
    <aside>
      <slot name="aside" />
    </aside>
  </section>
</SiteLayout>
