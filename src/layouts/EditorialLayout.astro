---
import { getCollection } from 'astro:content'

import Breadcrumbs from '../components/Breadcrumbs.astro'
import ShareButtons from '../components/ShareButtons.astro'
import {
  articleTitle,
  breadcrumbsForPage,
  canonicalInternalPath,
  formatDate,
  safeURL,
  settings,
  sitePath
} from '../lib/helpers/siteHelpers.mjs'
import { generateArticleSchema } from '../lib/helpers/seoHelpers.mjs'
import SiteLayout from './SiteLayout.astro'

const copy = settings.ui.editorial
const { entry, allPages = [], headings = [], neighbours = [] } = Astro.props
const title = articleTitle(entry)
const breadcrumbs = breadcrumbsForPage(entry, allPages, copy.home_breadcrumb)
const originalSource = safeURL(entry.data.source_url)
const hasSourceNote = Boolean(entry.data.attribution || originalSource || entry.data.updated_on)
const hasAside = headings.length > 0 || neighbours.length > 0 || Astro.slots.has('aside')
const contributors = entry.data.contributors?.length
  ? (await getCollection('contributors')).filter((profile) =>
      entry.data.contributors.includes(profile.id)
    )
  : []

const siteBase = Astro.site ? Astro.site.href : settings.site.url
const canonicalUrl = Astro.site
  ? new URL(canonicalInternalPath(Astro.url.pathname), Astro.site).href
  : `${siteBase.replace(/\/+$/, '')}${entry.data.path}`

const heroImage = entry.data.hero?.image
const heroAlt = entry.data.hero?.alt || title

const articleSchema = generateArticleSchema(
  {
    title,
    description: entry.data.description,
    url: canonicalUrl,
    imageUrl: heroImage,
    publishedOn: entry.data.published_on,
    updatedOn: entry.data.updated_on,
    author: entry.data.author
  },
  siteBase
)
---

<SiteLayout
  title={title}
  description={entry.data.description}
  image={heroImage ? { src: heroImage, alt: heroAlt } : undefined}
  type="article"
  article={{
    publishedTime: entry.data.published_on
      ? new Date(entry.data.published_on).toISOString()
      : undefined,
    modifiedTime: entry.data.updated_on ? new Date(entry.data.updated_on).toISOString() : undefined,
    author: entry.data.author
  }}
  breadcrumbs={breadcrumbs}
  schema={articleSchema}
>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      {!entry.data.source_url && entry.data.description && <p>{entry.data.description}</p>}
      {entry.data.author && (
        <p class="article-byline">
          {entry.data.author}
          {entry.data.published_on && ` · ${formatDate(entry.data.published_on)}`}
        </p>
      )}
      {contributors.length > 0 && (
        <p>
          {contributors.map((profile) => (
            <a href={sitePath(`/people/${profile.data.slug}/`)}>{profile.data.name} </a>
          ))}
        </p>
      )}
    </div>
  </header>
  <div class:list={['section', 'shell', 'article-layout', !hasAside && 'article-layout-no-aside']}>
    <div>
      <slot />
      <ShareButtons title={title} description={entry.data.description} />
      {hasSourceNote && (
        <div class="source-note">
          {entry.data.attribution && <p>{entry.data.attribution}</p>}
          {originalSource && <a href={originalSource}>{copy.original_source_link}</a>}
          {entry.data.updated_on && (
            <p>
              {copy.updated_prefix}{' '}
              <time datetime={entry.data.updated_on.toISOString().slice(0, 10)}>
                {formatDate(entry.data.updated_on)}
              </time>
            </p>
          )}
        </div>
      )}
    </div>
    {hasAside && (
      <aside class="article-aside">
        <div>
          {headings.length > 0 && (
            <>
              <h2>{copy.on_this_page}</h2>
              <nav aria-label={copy.on_this_page}>
                {headings.map((heading) => (
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                ))}
              </nav>
            </>
          )}
          {neighbours.length > 0 && (
            <>
              <h2 style="margin-top:2rem">{copy.in_this_section}</h2>
              <nav aria-label={copy.in_this_section}>
                {neighbours.map((page) => (
                  <a href={sitePath(page.data.path)}>{articleTitle(page)}</a>
                ))}
              </nav>
            </>
          )}
          <slot name="aside" />
        </div>
      </aside>
    )}
  </div>
</SiteLayout>
