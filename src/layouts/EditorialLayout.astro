---
import SiteLayout from './SiteLayout.astro';
import { ChevronRight } from '@lucide/astro';
import { articleTitle, formatDate, safeURL, settings, sitePath } from '../lib/site.mjs';
import { getCollection } from 'astro:content';
const copy = settings.ui.editorial;
const { entry, label = copy.labels.articles, headings = [], neighbours = [] } = Astro.props;
const title = articleTitle(entry);
const originalSource = safeURL(entry.data.source_url);
const contributors = (await getCollection('contributors')).filter((profile) =>
  entry.data.contributors?.includes(profile.id)
);
---

<SiteLayout title={title} description={entry.data.description}>
  <header class="page-heading">
    <div class="shell">
      <nav class="breadcrumbs" aria-label={copy.breadcrumb_aria_label}>
        <a href={sitePath('/')}>{copy.home_breadcrumb}</a>
        <ChevronRight size={13} aria-hidden="true" />
        <span>{label}</span>
      </nav>
      <h1>{title}</h1>
      {!entry.data.source_url && entry.data.description && <p>{entry.data.description}</p>}
      {entry.data.author && (
        <p class="article-byline">
          {entry.data.author}
          {entry.data.published_on && ` · ${formatDate(entry.data.published_on)}`}
        </p>
      )}
      {contributors.length > 0 && (
        <p>
          {contributors.map((profile) => (
            <a href={sitePath(`/people/${profile.data.slug}/`)}>{profile.data.name} </a>
          ))}
        </p>
      )}
    </div>
  </header>
  <div class="section shell article-layout">
    <div>
      <slot />
      <div class="source-note">
        {entry.data.attribution && <p>{entry.data.attribution}</p>}
        {originalSource && (
          <a href={originalSource}>{copy.original_source_link}</a>
        )}
        {entry.data.updated_on && (
          <p>
            {copy.updated_prefix}{' '}
            <time datetime={entry.data.updated_on.toISOString().slice(0, 10)}>
              {formatDate(entry.data.updated_on)}
            </time>
          </p>
        )}
      </div>
    </div>
    <aside class="article-aside">
      <div>
        {headings.length > 0 && (
          <>
            <h2>{copy.on_this_page}</h2>
            <nav aria-label={copy.on_this_page}>
              {headings.map((heading) => (
                <a href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </>
        )}
        {neighbours.length > 0 && (
          <>
            <h2 style="margin-top:2rem">{copy.in_this_section}</h2>
            <nav aria-label={copy.in_this_section}>
              {neighbours.map((page) => (
                <a href={sitePath(page.data.path)}>{articleTitle(page)}</a>
              ))}
            </nav>
          </>
        )}
        <slot name="aside" />
      </div>
    </aside>
  </div>
</SiteLayout>
