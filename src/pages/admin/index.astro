---
import { settings, sitePath } from '../../lib/site/siteHelpers.mjs'
const publicSiteURL = import.meta.env.PUBLIC_SITE_URL || settings.site.url
/** @param value - Public-site help path. @returns A link to the public host rather than the CMS-only deployment. */
const publicSitePath = (value) =>
  publicSiteURL
    ? new URL(value.replace(/^\/+/, ''), `${publicSiteURL.replace(/\/+$/, '')}/`).href
    : sitePath(value)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link href={sitePath('/admin/config.yml')} type="text/yaml" rel="cms-config-url" />
    <title>{settings.site.title} {settings.ui.admin.title_suffix}</title>
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <nav class="cms-help-links" aria-label="Editor help">
      <span id="cms-user-badge" class="cms-user-badge" style="display: none;"></span>
      <a href={sitePath('/admin/review/')}>Data review</a>
      <a href={publicSitePath('/editing-guide/')}>Editing guide</a>
      <a href={publicSitePath('/sitemap/')}>Site map</a>
    </nav>
    <script is:inline>
      window.CMS_MANUAL_INIT = true
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.reload()
            })
          }
        })
        window.netlifyIdentity.on('logout', () => {
          document.location.href = '/admin/'
        })
      }
    </script>
    <script is:inline src="https://unpkg.com/decap-cms@3.17.3/dist/decap-cms.js"></script>
    <script>
      import { parse as parseYaml } from 'yaml'
      import { prepareDirectoryEdit } from '../../lib/directory/schemaHelpers.mjs'
      import { registerEditorComponents } from '../../lib/cms/cmsHelpers.mjs'
      import {
        parseDomainPermissions,
        resolveUserPermissions,
        validateEntrySave
      } from '../../lib/cms/cmsAuthHelpers.mjs'
      import domainPermissionsCsv from '../../data/auth/domain-permissions.csv?raw'
      import cmsConfigRaw from '../../../public/admin/config.yml?raw'
      import previewStyles from '../../styles/global.css?inline'

      const domainPermissions = parseDomainPermissions(domainPermissionsCsv)

      const getCurrentPermissions = () => {
        const netlifyIdentity = Reflect.get(window, 'netlifyIdentity')
        const user = netlifyIdentity?.currentUser?.()
        if (!user) {
          return {
            allowed: true,
            email: 'local@dev',
            domain: 'dev',
            role: 'general-editor',
            gssCodes: ['*'],
            isGeneralEditor: true,
            notes: 'Local development editor'
          }
        }
        return resolveUserPermissions(user, domainPermissions)
      }

      const syncUserScopeUI = (permissions) => {
        if (!permissions) return
        if (!permissions.isGeneralEditor && permissions.role === 'service-editor') {
          document.body.classList.add('is-service-editor')
        } else {
          document.body.classList.remove('is-service-editor')
        }

        const badge = document.getElementById('cms-user-badge')
        if (badge && permissions.email && permissions.email !== 'local@dev') {
          const scope = permissions.isGeneralEditor
            ? 'General Editor'
            : `Service Editor (${permissions.gssCodes.join(', ') || 'unassigned'})`
          badge.textContent = `${permissions.email} • ${scope}`
          badge.style.display = 'inline-block'
        }
      }

      const stampedFields = {
        pages: ['updated_on'],
        resources: ['updated_on'],
        sessions: ['updated_on'],
        contributors: ['updated_on'],
        authorities: ['updated_on', 'reviewed_on'],
        libraries: ['updated_on', 'reviewed_on']
      }

      const cms = Reflect.get(window, 'CMS')
      if (cms) {
        registerEditorComponents(cms)

        const initialPermissions = getCurrentPermissions()
        syncUserScopeUI(initialPermissions)

        const netlifyIdentity = Reflect.get(window, 'netlifyIdentity')
        if (netlifyIdentity) {
          netlifyIdentity.on('login', () => {
            syncUserScopeUI(getCurrentPermissions())
          })
          netlifyIdentity.on('logout', () => {
            syncUserScopeUI(getCurrentPermissions())
          })
        }

        cms.registerEventListener({
          name: 'preSave',
          /** @param context - Decap entry being saved. @returns Normalized immutable values with actual edit/review dates stamped. */
          handler: ({ entry }) => {
            try {
              const permissions = getCurrentPermissions()
              const collection = entry.get('collection')
              let data = entry.get('data')

              if (collection === 'libraries' || collection === 'authorities') {
                const prepared = prepareDirectoryEdit(data.toJS(), collection)
                validateEntrySave(prepared, collection, permissions)
                for (const [field, value] of Object.entries(prepared)) {
                  data = data.set(field, value)
                }
                if (data.has('data')) {
                  data = data.delete('data')
                }
              } else {
                validateEntrySave(data.toJS(), collection, permissions)
              }

              const today = new Date().toLocaleDateString('en-CA')
              return (stampedFields[entry.get('collection')] || []).reduce(
                (data, field) => data.set(field, today),
                data
              )
            } catch (err) {
              console.error('Decap CMS preSave handler failed:', err)
              throw err
            }
          }
        })

        cms.registerPreviewStyle(previewStyles, { raw: true })

        if (
          initialPermissions.role === 'service-editor' &&
          !initialPermissions.isGeneralEditor &&
          initialPermissions.gssCodes?.length &&
          !initialPermissions.gssCodes.includes('*')
        ) {
          const config = parseYaml(cmsConfigRaw)
          const primaryGss = initialPermissions.gssCodes[0]
          const libCol = config.collections?.find((c) => c.name === 'libraries')
          if (libCol) {
            libCol.filter = {
              field: 'Local authority code',
              value: primaryGss
            }
          }
          const authCol = config.collections?.find((c) => c.name === 'authorities')
          if (authCol) {
            authCol.filter = {
              field: 'Local authority code',
              value: primaryGss
            }
          }
          cms.init({ config })
        } else {
          cms.init()
        }
      }
    </script>
  </body>
</html>

<style>
  .cms-help-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #d2d1d4;
    background: #fff;
    font: 0.8rem/1.3 sans-serif;
  }

  .cms-user-badge {
    margin-right: auto;
    font-weight: 600;
    color: #4a4a4a;
  }

  :global(body.is-service-editor a[href='#/collections/settings']),
  :global(body.is-service-editor a[href='#/collections/homepage']),
  :global(body.is-service-editor a[href='#/collections/pages']),
  :global(body.is-service-editor a[href='#/collections/faqs']),
  :global(body.is-service-editor a[href='#/collections/resources']),
  :global(body.is-service-editor a[href='#/collections/sessions']),
  :global(body.is-service-editor a[href='#/collections/organisations']),
  :global(body.is-service-editor a[href='#/collections/contributors']) {
    display: none !important;
  }
</style>
