---
import { settings, sitePath } from '../../lib/site.mjs'
const publicSiteURL = import.meta.env.PUBLIC_SITE_URL || settings.site.url
/** @param value - Public-site help path. @returns A link to the public host rather than the CMS-only deployment. */
const publicSitePath = (value) =>
  publicSiteURL
    ? new URL(value.replace(/^\/+/, ''), `${publicSiteURL.replace(/\/+$/, '')}/`).href
    : sitePath(value)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link href={sitePath('/admin/config.yml')} type="text/yaml" rel="cms-config-url" />
    <title>{settings.site.title} {settings.ui.admin.title_suffix}</title>
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <nav class="cms-help-links" aria-label="Editor help">
      <a href={sitePath('/admin/review/')}>Data review</a>
      <a href={publicSitePath('/editing-guide/')}>Editing guide</a>
      <a href={publicSitePath('/sitemap/')}>Site map</a>
    </nav>
    <script is:inline>
      window.CMS_MANUAL_INIT = true
    </script>
    <script is:inline src="https://unpkg.com/decap-cms@3.17.3/dist/decap-cms.js"></script>
    <script>
      import { prepareDirectoryEdit } from '../../lib/directory-schema.mjs'

      const stampedFields = {
        pages: ['updated_on'],
        resources: ['updated_on'],
        sessions: ['updated_on'],
        contributors: ['updated_on'],
        authorities: ['updated_on', 'reviewed_on'],
        libraries: ['updated_on', 'reviewed_on']
      }
      const cms = Reflect.get(window, 'CMS')
      cms.registerEventListener({
        name: 'preSave',
        /** @param context - Decap entry being saved. @returns Normalized immutable values with actual edit/review dates stamped. */
        handler: ({ entry }) => {
          const today = new Date().toLocaleDateString('en-CA')
          const collection = entry.get('collection')
          let data = entry.get('data')
          if (collection === 'libraries' || collection === 'authorities') {
            const prepared = prepareDirectoryEdit(data.toJS(), collection)
            for (const [field, value] of Object.entries(prepared.data)) {
              data = data.setIn(['data', field], value)
            }
            data = data.set('validation_exceptions', prepared.validation_exceptions)
          }
          return (stampedFields[entry.get('collection')] || []).reduce(
            (data, field) => data.set(field, today),
            data
          )
        }
      })
    </script>
    <script>
      import { registerEditorComponents } from '../../lib/cms-editor-components.mjs'
      import previewStyles from '../../styles/global.css?inline'
      const cms = Reflect.get(window, 'CMS')
      registerEditorComponents(cms)
      cms.registerPreviewStyle(previewStyles, { raw: true })
      cms.init()
    </script>
  </body>
</html>

<style>
  .cms-help-links {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #d2d1d4;
    background: #fff;
    font: 0.8rem/1.3 sans-serif;
  }
</style>
