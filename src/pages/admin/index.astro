---
/** @fileoverview Stock Decap Git Gateway editor with Netlify Identity, scoped forms and archive widgets. */
import { settings, sitePath } from '../../lib/site/siteHelpers.mjs'
import '../../styles/admin.css'
const publicSiteURL = import.meta.env.PUBLIC_SITE_URL || settings.site.url
/**
 * Resolve help links against the public host rather than the CMS-only deployment.
 * @param {string} value - Public page path.
 * @returns {string} Absolute public URL or base-aware local path.
 */
const publicSitePath = (value) =>
  publicSiteURL
    ? new URL(value.replace(/^\/+/, ''), `${publicSiteURL.replace(/\/+$/, '')}/`).href
    : sitePath(value)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link href={sitePath('/admin/config.yml')} type="text/yaml" rel="cms-config-url" />
    <title>{settings.site.title} {settings.ui.admin.title_suffix}</title>
    <!--noinspection JSUnresolvedLibraryURL-->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body>
    <nav class="cms-help-links" aria-label="Editor help">
      <span id="cms-user-badge" class="cms-user-badge" style="display: none;"></span>
      <a href={sitePath('/admin/archive/')} target="_blank" rel="noopener">
        Archive files
      </a>
      <a href={sitePath('/admin/review/')}>Data review</a>
      <a href={publicSitePath('/editing-guide/')}>Editing guide</a>
      <a href={publicSitePath('/sitemap/')}>Site map</a>
    </nav>
    <p id="cms-load-error" role="alert" hidden></p>
    <div id="cms-save-error" class="cms-save-error" role="alert" aria-live="assertive" hidden>
      <strong>Unable to save changes.</strong>
      <span id="cms-save-error-message"></span>
      <button id="cms-save-error-dismiss" type="button" aria-label="Dismiss save error">
        Dismiss
      </button>
    </div>
    <script is:inline>
      window.CMS_MANUAL_INIT = true
      window.CMS_IDENTITY_READY = window.netlifyIdentity
        ? new Promise((resolve) => window.netlifyIdentity.on('init', resolve))
        : Promise.resolve()
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) window.netlifyIdentity.on('login', () => document.location.reload())
        })
        window.netlifyIdentity.on('logout', () => {
          document.location.href = '/admin/'
        })
      }
    </script>
    <!--noinspection JSUnresolvedLibraryURL-->
    <script is:inline src="https://unpkg.com/decap-cms@3.18.0/dist/decap-cms.js"></script>
    <script src="../../scripts/cmsAdminClient.mjs"></script>
  </body>
</html>
