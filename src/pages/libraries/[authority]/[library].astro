---
import { libraries, authorityByLibrary } from '../../../lib/directory/directoryLoader.mjs'
import LibraryTemplate from '../../../templates/LibraryTemplate.astro'

export function getStaticPaths() {
  return libraries.map((library) => ({
    params: {
      authority: authorityByLibrary.get(library.id)?.slug || 'unassigned',
      library: library.slug
    },
    props: { library, authority: authorityByLibrary.get(library.id) }
  }))
}

const { library, authority } = Astro.props
---

<LibraryTemplate library={library} authority={authority} />
