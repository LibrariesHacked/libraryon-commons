---
import { ChevronDown, X } from '@lucide/astro'

import LibrarySearch from '../../components/LibrarySearch.astro'
import LibraryMap from '../../components/LibraryMap.astro'
import LibraryDownloads from '../../components/LibraryDownloads.astro'
import TagListSection from '../../components/TagListSection.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import {
  libraries,
  authorities,
  searchRecords,
  collectValues,
  facilityLabel
} from '../../lib/directory/directoryLoader.mjs'
import { settings, sitePath } from '../../lib/site/siteHelpers.mjs'

const copy = settings.ui.library_search
const libraryOnServiceOrder = [
  'Archives',
  'Books',
  'Bookable space',
  'Books delivered',
  'Business support',
  'Career support',
  'Digital skills sessions',
  "Children's activities",
  'Cafe',
  'BFI Replay',
  'British Newspaper Archive',
  'Events',
  'Family history',
  'Findmypast',
  'Hobby and interest groups',
  'Garden',
  'Computers',
  'Digital lending',
  'Faxing',
  'Free Wi-Fi',
  'Photocopiers',
  'Printing',
  'Scanning',
  'Local info',
  'Makerspace',
  'Toilets',
  'Work space'
]
const allServices = collectValues(libraries, (library) =>
  (library.services || []).map((item) => item.service).filter(Boolean)
).sort((first, second) => {
  const firstIndex = libraryOnServiceOrder.indexOf(first)
  const secondIndex = libraryOnServiceOrder.indexOf(second)
  if (firstIndex !== -1 && secondIndex !== -1) return firstIndex - secondIndex
  if (firstIndex !== -1) return -1
  if (secondIndex !== -1) return 1
  return first.localeCompare(second, 'en-GB', { sensitivity: 'base' })
})
const allAccessibility = collectValues(libraries, (library) => library.accessibility || [])
  .map((value) => ({ value, label: facilityLabel(value) }))
  .sort((first, second) =>
    first.label.localeCompare(second.label, 'en-GB', { sensitivity: 'base' })
  )
const initialVisibleTags = 7
const initialResults = searchRecords.filter((record) => !record.closed).slice(0, 60)
---

<SiteLayout title={copy.title} description={copy.description}>
  <section class="page-heading">
    <div class="shell">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>
        {libraries.length.toLocaleString('en-GB')} {copy.intro_library_count}{' '}
        {authorities.length.toLocaleString('en-GB')} {copy.intro_authority_count}
      </p>
    </div>
  </section>
  <section class="section shell">
    <form
      id="library-search"
      class="library-search-form"
      role="search"
      aria-label="Library search"
      data-testid="libraries-search"
      data-index-url={sitePath('/directory.json')}
      data-all-index-url={sitePath('/directory-all.json')}
      data-unassigned-authority={copy.unassigned_authority}
      data-marked-permanently-closed={
        settings.ui.directory.marked_permanently_closed || 'Marked as permanently closed'
      }
      data-no-matches={copy.no_matches}
      data-index-error={copy.index_error}
      data-singular={copy.singular}
      data-plural={copy.plural}
      data-authority-browse-status={copy.authority_browse_status}
      data-current-location={copy.current_location}
      data-view-all={copy.view_all}
      data-show-less={copy.show_less}
      data-miles-suffix={copy.miles_suffix}
      data-distance-filter={copy.distance_filter}
    >
      <LibrarySearch id="library" mode="inline" />

      <div class="library-filter-tabs">
        <div class="tab-filter" id="services-tab">
          <button
            id="services-toggle"
            class="tab-filter-button"
            type="button"
            aria-expanded="false"
            aria-controls="Services-panel"
            popovertarget="Services-panel"
          >
            <span>{copy.services_filter}</span>
            <span id="services-count" class="filter-badge" hidden>
              0
            </span>
            <ChevronDown size={16} aria-hidden="true" />
          </button>
          <div
            id="Services-panel"
            class="tab-filter-panel"
            role="dialog"
            aria-label={copy.services_filter}
            popover="auto"
          >
            <div class="tab-filter-body">
              <div class="search-options-row">
                <label class="search-option-toggle" for="library-open-now">
                  <span>{copy.open_now_label}</span>
                  <span class="search-option-divider" aria-hidden="true"></span>
                  <input id="library-open-now" name="openNow" type="checkbox" />
                </label>
                <label class="search-option-toggle" for="library-include-closed">
                  <span>{copy.include_closed_label || 'Include permanently closed libraries'}</span>
                  <span class="search-option-divider" aria-hidden="true"></span>
                  <input id="library-include-closed" name="closed" type="checkbox" />
                </label>
              </div>

              <TagListSection
                heading={copy.services_heading}
                items={allServices}
                mode="select"
                tagGroup="services"
                initialVisible={initialVisibleTags}
                viewAllLabel={copy.view_all}
              />

              <TagListSection
                heading={copy.accessibility_heading}
                items={allAccessibility}
                mode="select"
                tagGroup="accessibility"
                initialVisible={initialVisibleTags}
                viewAllLabel={copy.view_all}
              />
            </div>
            <div class="tab-filter-footer">
              <button id="clear-services" class="button button-secondary" type="button">
                {copy.clear_button}
              </button>
              <button id="apply-services" class="button" type="button">
                {copy.apply_button}
              </button>
            </div>
          </div>
        </div>

        <div class="tab-filter" id="distance-tab">
          <button
            id="distance-toggle"
            class="tab-filter-button"
            type="button"
            aria-expanded="false"
            aria-controls="Distance-panel"
            popovertarget="Distance-panel"
            disabled
          >
            <span id="distance-button-label">{copy.distance_filter}</span>
            <ChevronDown size={16} aria-hidden="true" />
          </button>
          <div
            id="Distance-panel"
            class="tab-filter-panel tab-filter-panel-narrow"
            role="dialog"
            aria-label={copy.distance_filter}
            popover="auto"
          >
            <div class="tab-filter-body">
              <div class="distance-slider-group">
                <label class="distance-slider-label" for="library-distance">
                  <span>{copy.distance_filter}</span>
                  <strong id="distance-value" data-testid="distance-label">
                    5 {copy.miles_suffix}
                  </strong>
                </label>
                <input
                  id="library-distance"
                  name="distance"
                  type="range"
                  min="1"
                  max="50"
                  value="5"
                />
              </div>
              <div class="distance-location-row">
                <div class="distance-location-meta">
                  <strong>{copy.location_prefix}</strong>
                  <span id="location-label">{copy.current_location}</span>
                </div>
                <button
                  id="clear-location"
                  class="button button-secondary clear-location-button"
                  type="button"
                  aria-label={copy.clear_location}
                  title={copy.clear_location}
                >
                  <X size={16} aria-hidden="true" />
                </button>
              </div>
            </div>
            <div class="tab-filter-footer">
              <button id="clear-distance" class="button button-secondary" type="button">
                {copy.clear_button}
              </button>
              <button id="apply-distance" class="button" type="button">
                {copy.apply_button}
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>

    <section class="library-results-workspace" aria-labelledby="library-results-heading">
      <div class="results-heading">
        <h2 id="library-results-heading">{copy.results_heading}</h2>
        <p id="result-count" aria-live="polite">
          {copy.browse_status}
        </p>
      </div>
      <div class="library-results-layout">
        <LibraryMap
          id="library-results-map"
          label="Matching library locations"
          emptyMessage="No mapped libraries match these filters."
        />
        <div class="library-results-column">
          <ul id="library-results" class="library-results">
            {initialResults.map((library) => (
              <li>
                <div class="library-result-header">
                  <h3>
                    <a href={sitePath(library.url)}>{library.name}</a>
                  </h3>
                </div>
                <p>{library.address || library.postcode}</p>
                <div class="library-result-meta">
                  <span class="authority-label">
                    {library.authorityName}
                    {library.country ? ` · ${library.country}` : ''}
                  </span>
                </div>
              </li>
            ))}
          </ul>
          <button id="more-results" class="load-more" type="button">
            {copy.more_button}
          </button>
        </div>
      </div>
    </section>
    <p class="notice">{copy.review_notice}</p>
    <details class="disclosure">
      <summary>
        {copy.authority_disclosure} ({authorities.length.toLocaleString('en-GB')})
      </summary>
      <ul class="authority-grid">
        {authorities.map((authority) => (
          <li>
            <a href={sitePath(`/libraries/${authority.slug}/`)}>{authority.name}</a>
            <small>
              {authority.country} · {(authority.library_ids || []).length} {copy.recorded_libraries}
            </small>
          </li>
        ))}
      </ul>
    </details>
    <LibraryDownloads entries={libraries} />
  </section>
</SiteLayout>

<script>
  import { autoUpdate, computePosition, flip, offset, shift } from '@floating-ui/dom'
  import {
    distanceMiles,
    expandDirectory,
    isLibraryOpenAt,
    matchesLibrary
  } from '../../lib/directory/searchHelpers.mjs'
  import { sitePath } from '../../lib/site/siteHelpers.mjs'

  const form = document.querySelector('#library-search')
  const picker = form.querySelector('library-place-search')
  const servicesToggle = document.querySelector('#services-toggle')
  const servicesPanel = document.querySelector('#Services-panel')
  const servicesCountBadge = document.querySelector('#services-count')
  const openNowInput = document.querySelector('#library-open-now')
  const clearServicesButton = document.querySelector('#clear-services')
  const applyServicesButton = document.querySelector('#apply-services')
  const distanceToggle = document.querySelector('#distance-toggle')
  const distanceButtonLabel = document.querySelector('#distance-button-label')
  const distancePanel = document.querySelector('#Distance-panel')
  const distanceInput = document.querySelector('#library-distance')
  const distanceValue = document.querySelector('#distance-value')
  const locationLabel = document.querySelector('#location-label')
  const clearLocationButton = document.querySelector('#clear-location')
  const clearDistanceButton = document.querySelector('#clear-distance')
  const applyDistanceButton = document.querySelector('#apply-distance')
  const includeClosedInput = document.querySelector('#library-include-closed')
  const list = document.querySelector('#library-results')
  const count = document.querySelector('#result-count')
  const more = document.querySelector('#more-results')

  const params = new URLSearchParams(window.location.search)
  const initialQuery = params.get('q') || params.get('query') || ''

  const selectedServices = new Set(
    (params.get('service') || '')
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean)
  )
  const selectedAccessibility = new Set(
    (params.get('accessibility') || '')
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean)
  )
  openNowInput.checked = params.get('openNow') === 'true' || params.get('openNow') === '1'
  if (includeClosedInput) {
    includeClosedInput.checked = params.get('closed') === 'true' || params.get('closed') === '1'
  }

  const parsedDistance = Number.parseInt(params.get('distance') || '5', 10)
  let selectedDistance =
    Number.isFinite(parsedDistance) && parsedDistance >= 1 && parsedDistance <= 50
      ? parsedDistance
      : 5
  distanceInput.value = String(selectedDistance)

  let explicitLocation = null
  let distanceFilterActive = false
  const latParam = params.get('latitude') || params.get('lat')
  const lngParam = params.get('longitude') || params.get('lng') || params.get('lon')
  let initialLat = latParam ? Number.parseFloat(latParam) : Number.NaN
  let initialLng = lngParam ? Number.parseFloat(lngParam) : Number.NaN
  if (!Number.isFinite(initialLat) || !Number.isFinite(initialLng)) {
    const locParam = params.get('loc')
    if (locParam) {
      const [locLat, locLng] = locParam.split(',').map(Number)
      if (Number.isFinite(locLat) && Number.isFinite(locLng)) {
        initialLat = locLat
        initialLng = locLng
      }
    }
  }
  if (Number.isFinite(initialLat) && Number.isFinite(initialLng)) {
    explicitLocation = {
      latitude: initialLat,
      longitude: initialLng,
      label: initialQuery || form.dataset.currentLocation
    }
    distanceFilterActive = true
  }

  let openRecords = null
  let allRecords = null
  let records = []
  let matches = []
  let visible = 60

  const closePanels = () => {
    for (const panel of [servicesPanel, distancePanel])
      if (panel.matches(':popover-open')) panel.hidePopover()
  }

  for (const [panel, button] of [
    [servicesPanel, servicesToggle],
    [distancePanel, distanceToggle]
  ]) {
    let cleanup
    panel.addEventListener('beforetoggle', () => panel.removeAttribute('data-positioned'))
    panel.addEventListener('toggle', () => {
      const open = panel.matches(':popover-open')
      button.setAttribute('aria-expanded', String(open))
      cleanup?.()
      cleanup = open
        ? autoUpdate(button, panel, () => {
            computePosition(button, panel, {
              strategy: 'fixed',
              placement: 'bottom-start',
              middleware: [offset(8), flip(), shift({ padding: 12, crossAxis: true })]
            }).then(({ x, y }) => {
              if (!panel.matches(':popover-open')) return
              Object.assign(panel.style, { left: `${x}px`, top: `${y}px` })
              panel.setAttribute('data-positioned', 'true')
            })
          })
        : undefined
    })
  }

  for (const button of form.querySelectorAll('[data-toggle-tags]')) {
    button.addEventListener('click', () => {
      const groupName = button.dataset.toggleTags
      const group = form.querySelector(`[data-tag-group="${groupName}"]`)
      const expanded = button.dataset.expanded === 'true'
      for (const tag of group.querySelectorAll('[data-extra-tag="true"]')) {
        if (!expanded) {
          tag.hidden = false
        } else if (tag.getAttribute('aria-pressed') !== 'true') {
          tag.hidden = true
        }
      }
      button.dataset.expanded = expanded ? 'false' : 'true'
      button.textContent = expanded ? form.dataset.viewAll : form.dataset.showLess
    })
  }

  const syncTagButtons = () => {
    for (const button of form.querySelectorAll('[data-service]')) {
      const active = selectedServices.has(button.dataset.service)
      button.setAttribute('aria-pressed', active ? 'true' : 'false')
      if (active) button.hidden = false
    }
    for (const button of form.querySelectorAll('[data-accessibility]')) {
      const active = selectedAccessibility.has(button.dataset.accessibility)
      button.setAttribute('aria-pressed', active ? 'true' : 'false')
      if (active) button.hidden = false
    }
    const activeCount =
      selectedServices.size +
      selectedAccessibility.size +
      (openNowInput.checked ? 1 : 0) +
      (includeClosedInput?.checked ? 1 : 0)
    servicesCountBadge.hidden = activeCount === 0
    servicesCountBadge.textContent = String(activeCount)
  }

  for (const button of form.querySelectorAll('[data-service]')) {
    button.addEventListener('click', () => {
      const value = button.dataset.service
      if (selectedServices.has(value)) selectedServices.delete(value)
      else selectedServices.add(value)
      syncTagButtons()
      update()
    })
  }

  for (const button of form.querySelectorAll('[data-accessibility]')) {
    button.addEventListener('click', () => {
      const value = button.dataset.accessibility
      if (selectedAccessibility.has(value)) selectedAccessibility.delete(value)
      else selectedAccessibility.add(value)
      syncTagButtons()
      update()
    })
  }

  openNowInput.addEventListener('change', () => {
    syncTagButtons()
    update()
  })

  const activeLocation = () => explicitLocation

  const syncDistanceUI = (resolvedLoc) => {
    distanceValue.textContent = `${selectedDistance} ${form.dataset.milesSuffix}`
    distanceToggle.disabled = !resolvedLoc
    if (resolvedLoc) {
      locationLabel.textContent = resolvedLoc.label
      distanceButtonLabel.textContent = distanceFilterActive
        ? `${form.dataset.distanceFilter} (${selectedDistance} ${form.dataset.milesSuffix})`
        : form.dataset.distanceFilter
    } else {
      locationLabel.textContent = ''
      distanceButtonLabel.textContent = form.dataset.distanceFilter
      if (distancePanel.matches(':popover-open')) distancePanel.hidePopover()
      distanceToggle.setAttribute('aria-expanded', 'false')
    }
  }

  let selectedLibraryId = null

  const itemElement = (item, miles) => {
    const li = document.createElement('li')
    li.className = 'library-result-item'
    const itemId = item.id || item.slug || `${item.latitude},${item.longitude}`
    li.dataset.libraryId = itemId
    if (selectedLibraryId && selectedLibraryId === itemId) {
      li.classList.add('is-selected')
    }

    li.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return
      if (event.target instanceof Element && event.target.closest('a')) return

      event.preventDefault()
      const mapEl = document.querySelector('#library-results-map')
      if (selectedLibraryId === itemId) {
        selectedLibraryId = null
        for (const el of list.querySelectorAll('.library-result-item.is-selected')) {
          el.classList.remove('is-selected')
        }
        mapEl?.dispatchEvent(new CustomEvent('library-map-select', { detail: { unselect: true } }))
      } else {
        selectedLibraryId = itemId
        for (const el of list.querySelectorAll('.library-result-item.is-selected')) {
          el.classList.remove('is-selected')
        }
        li.classList.add('is-selected')
        mapEl?.dispatchEvent(new CustomEvent('library-map-select', { detail: { library: item } }))
      }
    })

    const header = document.createElement('div')
    header.className = 'library-result-header'
    const title = document.createElement('h3')
    const link = document.createElement('a')
    link.href = sitePath(item.url)
    link.textContent = item.name
    title.append(link)
    header.append(title)
    if (miles !== null && Number.isFinite(miles)) {
      const dist = document.createElement('span')
      dist.className = 'distance-badge'
      dist.textContent = `${miles.toFixed(1)} ${form.dataset.milesSuffix}`
      header.append(dist)
    }
    const address = document.createElement('p')
    address.textContent = item.address || item.postcode
    const metaRow = document.createElement('div')
    metaRow.className = 'library-result-meta'
    const authority = document.createElement('span')
    authority.className = 'authority-label'
    const metaParts = [item.authorityName || form.dataset.unassignedAuthority]
    if (item.country) metaParts.push(item.country)
    if (item.closed) {
      metaParts.push(form.dataset.markedPermanentlyClosed)
    }
    authority.textContent = metaParts.join(' · ')
    metaRow.append(authority)

    if (!item.closed && item.hours) {
      const hasHours = Object.values(item.hours).some(
        (slots) => Array.isArray(slots) && slots.length > 0
      )
      if (isLibraryOpenAt(item, new Date())) {
        const pill = document.createElement('span')
        pill.className = 'live-status-pill live-status-pill--small is-open'
        pill.innerHTML =
          '<span class="live-status-dot" aria-hidden="true"></span><span>Open now</span>'
        metaRow.append(pill)
      } else if (hasHours) {
        const pill = document.createElement('span')
        pill.className = 'live-status-pill live-status-pill--small is-closed'
        pill.innerHTML =
          '<span class="live-status-dot" aria-hidden="true"></span><span>Closed</span>'
        metaRow.append(pill)
      }
    }

    li.append(header, address, metaRow)
    return li
  }

  const render = (resolvedLoc) => {
    list.replaceChildren(
      ...matches.slice(0, visible).map((item) => {
        const miles = distanceFilterActive && resolvedLoc ? distanceMiles(resolvedLoc, item) : null
        return itemElement(item, miles)
      })
    )
    count.textContent = `${matches.length.toLocaleString('en-GB')} ${
      matches.length === 1 ? form.dataset.singular : form.dataset.plural
    }`
    more.hidden = visible >= matches.length
    if (!matches.length) {
      const empty = document.createElement('li')
      empty.textContent = form.dataset.noMatches
      list.append(empty)
    }
  }

  const appendMore = (resolvedLoc) => {
    const prevVisible = visible
    visible += 60
    const fragment = document.createDocumentFragment()
    matches.slice(prevVisible, visible).forEach((item) => {
      const miles = distanceFilterActive && resolvedLoc ? distanceMiles(resolvedLoc, item) : null
      fragment.append(itemElement(item, miles))
    })
    list.append(fragment)
    more.hidden = visible >= matches.length
  }

  const syncURL = (resolvedLoc) => {
    const nextParams = new URLSearchParams()
    if (resolvedLoc && resolvedLoc.label !== form.dataset.currentLocation) {
      nextParams.set('q', resolvedLoc.label)
    }
    if (selectedServices.size) {
      nextParams.set('service', [...selectedServices].join(','))
    }
    if (selectedAccessibility.size) {
      nextParams.set('accessibility', [...selectedAccessibility].join(','))
    }
    if (openNowInput.checked) {
      nextParams.set('openNow', 'true')
    }
    if (includeClosedInput?.checked) {
      nextParams.set('closed', 'true')
    }
    if (distanceFilterActive && resolvedLoc) {
      nextParams.set('distance', String(selectedDistance))
      if (explicitLocation) {
        nextParams.set('latitude', explicitLocation.latitude.toFixed(5))
        nextParams.set('longitude', explicitLocation.longitude.toFixed(5))
      }
    }
    const search = nextParams.toString()
    window.history.replaceState(
      null,
      '',
      `${window.location.pathname}${search ? `?${search}` : ''}`
    )
  }

  const update = () => {
    if (!records.length) return
    visible = 60
    const resolvedLoc = activeLocation()
    syncDistanceUI(resolvedLoc)
    const filters = {
      services: [...selectedServices],
      accessibility: [...selectedAccessibility],
      openNow: openNowInput.checked,
      location: distanceFilterActive ? resolvedLoc : null,
      distance: selectedDistance
    }
    matches = records.filter((record) => matchesLibrary(record, filters))
    if (
      selectedLibraryId &&
      !matches.some((m) => (m.id || m.slug || `${m.latitude},${m.longitude}`) === selectedLibraryId)
    ) {
      selectedLibraryId = null
    }
    if (distanceFilterActive && resolvedLoc) {
      matches.sort((first, second) => {
        const firstMiles = distanceMiles(resolvedLoc, first) ?? Number.POSITIVE_INFINITY
        const secondMiles = distanceMiles(resolvedLoc, second) ?? Number.POSITIVE_INFINITY
        return firstMiles - secondMiles
      })
    }
    syncURL(resolvedLoc)
    document.querySelector('#library-results-map')?.dispatchEvent(
      new CustomEvent('library-map-update', {
        detail: { records: matches, location: resolvedLoc }
      })
    )
    render(resolvedLoc)
  }

  picker.addEventListener('library-location', (event) => {
    explicitLocation = event.detail
    distanceFilterActive = true
    update()
  })

  const mapElement = document.querySelector('#library-results-map')
  mapElement?.addEventListener('library-map-popup-closed', () => {
    if (selectedLibraryId) {
      selectedLibraryId = null
      for (const el of list.querySelectorAll('.library-result-item.is-selected')) {
        el.classList.remove('is-selected')
      }
      mapElement.dispatchEvent(
        new CustomEvent('library-map-select', { detail: { unselect: true } })
      )
    }
  })

  mapElement?.addEventListener('library-map-point-clicked', (event) => {
    const { name } = event.detail || {}
    const match = matches.find((m) => m.name === name)
    if (match) {
      const matchId = match.id || match.slug || `${match.latitude},${match.longitude}`
      selectedLibraryId = matchId
      for (const el of list.querySelectorAll('.library-result-item')) {
        if (el.dataset.libraryId === matchId) {
          el.classList.add('is-selected')
          el.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
        } else {
          el.classList.remove('is-selected')
        }
      }
    }
  })

  clearServicesButton.addEventListener('click', () => {
    selectedServices.clear()
    selectedAccessibility.clear()
    openNowInput.checked = false
    const closedWasChecked = includeClosedInput?.checked
    if (includeClosedInput) includeClosedInput.checked = false
    syncTagButtons()
    if (closedWasChecked) {
      loadDirectory(false).catch(() => {
        count.textContent = form.dataset.authorityBrowseStatus
        more.hidden = true
      })
    } else {
      update()
    }
    closePanels()
  })

  applyServicesButton.addEventListener('click', () => {
    update()
    closePanels()
  })

  distanceInput.addEventListener('input', () => {
    selectedDistance = Number.parseInt(distanceInput.value, 10) || 5
    distanceFilterActive = true
    update()
  })

  const clearLocationState = () => {
    picker.dispatchEvent(new CustomEvent('library-location-clear'))
    explicitLocation = null
    distanceFilterActive = false
    selectedDistance = 5
    distanceInput.value = '5'
    update()
    closePanels()
  }

  clearLocationButton.addEventListener('click', clearLocationState)
  clearDistanceButton.addEventListener('click', clearLocationState)
  applyDistanceButton.addEventListener('click', () => {
    distanceFilterActive = true
    update()
    closePanels()
  })

  const loadDirectory = async (includeClosed) => {
    if (includeClosed) {
      if (!allRecords) {
        const response = await fetch(form.dataset.allIndexUrl)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        const data = await response.json()
        allRecords = expandDirectory(data)
      }
      records = allRecords
    } else {
      if (!openRecords) {
        const response = await fetch(form.dataset.indexUrl)
        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        const data = await response.json()
        openRecords = expandDirectory(data)
      }
      records = openRecords
    }
    syncTagButtons()
    update()
  }

  includeClosedInput?.addEventListener('change', () => {
    syncTagButtons()
    loadDirectory(includeClosedInput.checked).catch((err) => {
      console.error('Failed to load full directory index:', err)
      count.textContent = form.dataset.authorityBrowseStatus
      more.hidden = true
    })
  })

  loadDirectory(includeClosedInput?.checked).catch((err) => {
    console.error('Failed to load directory search index:', err)
    count.textContent = form.dataset.authorityBrowseStatus
    more.hidden = true
    const notice = document.createElement('p')
    notice.className = 'notice'
    notice.setAttribute('role', 'status')
    notice.textContent = form.dataset.indexError
    form.after(notice)
  })

  form.addEventListener('submit', (event) => {
    event.preventDefault()
  })
  more.addEventListener('click', () => {
    appendMore(activeLocation())
  })
</script>
