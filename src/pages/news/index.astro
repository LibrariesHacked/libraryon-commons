---
import {
  BookOpen,
  Briefcase,
  Building,
  Calendar,
  ChevronDown,
  CircleCheck,
  DoorClosed,
  Globe,
  Heart,
  Info,
  Landmark,
  Megaphone,
  Monitor,
  RotateCcw,
  Search,
  SlidersHorizontal,
  Sparkles,
  TrendingDown,
  TrendingUp,
  Users
} from '@lucide/astro'
import { getEntry, render } from 'astro:content'
import SiteLayout from '../../layouts/SiteLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import NewsCard from '../../components/NewsCard.astro'
import NewsMap from '../../components/NewsMap.astro'
import {
  getNewsMetadata,
  getNewsIndexStories,
  filterStoriesByDate,
  categoryColor,
  categoryLabel,
  changeTypeLabel,
  CATEGORY_LABELS,
  CHANGE_TYPE_LABELS
} from '../../lib/content/newsHelpers.mjs'
import { settings, sitePath } from '../../lib/site/siteHelpers.mjs'

const metadata = getNewsMetadata()
const allStories = getNewsIndexStories()

// Initial stories filtered to the past year for SSR (anchor to latest story or today)
const initialFilteredStories = filterStoriesByDate(allStories, { preset: '1y' })
const defaultStoriesPool = initialFilteredStories.length > 0 ? initialFilteredStories : allStories
const initialStories = defaultStoriesPool.slice(0, 30)
const initialMapStories = defaultStoriesPool.filter(
  (s) => typeof s.lat === 'number' && typeof s.lng === 'number'
)

const categoriesList = Object.entries(metadata.categories || {})
  .map(([key, count]) => ({
    key,
    label: CATEGORY_LABELS[key] || key.replace(/_/g, ' '),
    count
  }))
  .sort((a, b) => b.count - a.count)

const changeTypesList = Object.entries(metadata.change_types || {})
  .map(([key, count]) => ({
    key,
    label: CHANGE_TYPE_LABELS[key] || key.replace(/_/g, ' '),
    count
  }))
  .sort((a, b) => b.count - a.count)

const orgsList = Object.entries(metadata.organisations || {})
  .map(([key, label]) => ({ key, label, count: label }))
  .map(({ key }) => {
    const count = allStories.filter((s) => (s.organisations || []).includes(key)).length
    return { key, label: key, count }
  })
  .sort((a, b) => b.count - a.count)

const countriesList = Object.entries(metadata.countries || {})
  .map(([key, count]) => ({ key, label: key, count }))
  .sort((a, b) => b.count - a.count)

const authoritiesList = Object.entries(metadata.authorities || {})
  .map(([key, count]) => ({ key, label: key, count }))
  .sort((a, b) => a.label.localeCompare(b.label, 'en'))

function getCategoryIcon(key = '') {
  switch (key) {
    case 'funding_and_finance':
    case 'cuts_and_finance':
      return Landmark
    case 'closures_and_threats':
      return DoorClosed
    case 'campaigns_and_activism':
      return Megaphone
    case 'staffing_and_volunteers':
      return Users
    case 'digital_and_technology':
      return Monitor
    case 'community_and_outreach':
      return Building
    case 'services_and_activities':
      return BookOpen
    case 'events_and_initiatives':
      return Calendar
    default:
      return Sparkles
  }
}

function getChangeTypeIcon(key = '') {
  switch (key) {
    case 'closure':
      return DoorClosed
    case 'reduction':
    case 'threatened_reduction':
      return TrendingDown
    case 'threatened_closure':
    case 'service_threatened':
      return Info
    case 'investment':
    case 'refurbishment':
      return TrendingUp
    case 'new_library':
    case 'reopening':
      return Sparkles
    case 'community_handover':
    case 'transfer':
      return RotateCcw
    default:
      return CircleCheck
  }
}

function getOrgIcon(key = '') {
  const norm = key.toLowerCase()
  if (norm.includes('campaign')) return Megaphone
  if (norm.includes('cilip')) return Briefcase
  if (norm.includes('arts council')) return Sparkles
  if (norm.includes('good things')) return Heart
  if (norm.includes('government') || norm.includes('dcms')) return Landmark
  return Building
}

const newsPage = await getEntry('pages', 'news')
const { Content } = newsPage ? await render(newsPage) : { Content: null }
const title = newsPage?.data.title || 'Public Libraries News'
const description =
  newsPage?.data.description ||
  'Searchable news archive and interactive map of 38,000+ public library stories, funding updates, closures, and campaigns.'
const eyebrow = newsPage?.data.eyebrow || 'Sector News & Archive'
---

<SiteLayout title={`${title} | ${settings.site.title}`} description={description}>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs
        items={[
          { label: settings.ui.editorial?.home_breadcrumb || 'Home', href: '/' },
          { label: title, current: true }
        ]}
      />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {Content ? (
        <div class="page-intro">
          <Content />
        </div>
      ) : (
        <p>{description}</p>
      )}
    </div>
  </header>

  <main class="section shell">
    <form
      id="news-filter-form"
      class="library-search-form"
      role="search"
      aria-label="Filter news stories"
      data-news-url={sitePath('/news.json')}
      data-base-url={import.meta.env.BASE_URL}
      data-total-stories={metadata.total_stories}
      data-authority-slugs={JSON.stringify(metadata.authority_slugs_by_name || {})}
    >
      <div class="library-search-bar">
        <div class="library-search-input-wrap">
          <Search size={18} aria-hidden="true" />
          <input
            id="news-search-query"
            type="search"
            placeholder="Search keywords, council names, library branches..."
            aria-label="Search news stories"
            autocomplete="off"
          />
        </div>
        <button
          id="clear-all-filters"
          class="button button-secondary"
          type="button"
          title="Reset all filters"
        >
          <RotateCcw size={16} aria-hidden="true" />
          <span>Reset</span>
        </button>
      </div>

      <div class="library-filter-tabs">
        <div class="tab-filter" id="news-filter-tab">
          <button
            id="news-filter-toggle"
            class="tab-filter-button"
            type="button"
            aria-expanded="false"
            aria-controls="news-filter-panel"
            popovertarget="news-filter-panel"
          >
            <SlidersHorizontal size={16} aria-hidden="true" />
            <span>Filter News</span>
            <span id="news-filter-count" class="filter-badge" hidden>
              0
            </span>
            <ChevronDown size={16} aria-hidden="true" />
          </button>

          <div
            id="news-filter-panel"
            class="tab-filter-panel"
            role="dialog"
            aria-label="Filter news stories"
            popover="auto"
          >
            <div class="tab-filter-body">
              <!-- Time Period Slider -->
              <div class="filter-group">
                <div class="time-slider-group">
                  <div class="time-slider-header">
                    <label for="news-time-slider" class="filter-group-heading">
                      Time Period
                    </label>
                    <span id="time-slider-value" class="time-slider-current">
                      Past year
                    </span>
                  </div>
                  <div class="time-slider-wrap">
                    <input
                      id="news-time-slider"
                      name="time_slider"
                      type="range"
                      min="1"
                      max="5"
                      step="1"
                      value="1"
                      aria-label="Filter news by time period"
                    />
                    <div class="time-slider-ticks" aria-hidden="true">
                      <span>1 yr</span>
                      <span>2 yrs</span>
                      <span>3 yrs</span>
                      <span>5 yrs</span>
                      <span>All</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Categories -->
              <div class="filter-group">
                <p class="filter-group-heading">Category</p>
                <div class="facility-chips filter-tag-list" data-tag-group="category">
                  {categoriesList.map(({ key, label, count }, index) => {
                    const isExtra = index >= 8
                    const IconComponent = getCategoryIcon(key)
                    return (
                      <button
                        type="button"
                        class={`facility-chip facility-chip--${categoryColor(key)} filter-tag`}
                        data-filter-type="category"
                        data-filter-value={key}
                        data-extra-tag={isExtra ? 'true' : undefined}
                        hidden={isExtra ? true : undefined}
                        aria-pressed="false"
                      >
                        <span class="facility-chip-icon" aria-hidden="true">
                          <IconComponent size={15} />
                        </span>
                        <span class="facility-chip-label">{label}</span>
                        <span class="filter-tag-count">({count.toLocaleString('en-GB')})</span>
                      </button>
                    )
                  })}
                  {categoriesList.length > 8 && (
                    <button
                      type="button"
                      class="filter-tag-more"
                      data-toggle-tags="category"
                      data-expanded="false"
                    >
                      View all ({categoriesList.length})
                    </button>
                  )}
                </div>
              </div>

              <!-- Change Types -->
              <div class="filter-group">
                <p class="filter-group-heading">Type of Service Change</p>
                <div class="facility-chips filter-tag-list" data-tag-group="change_type">
                  {changeTypesList.map(({ key, label, count }, index) => {
                    const isExtra = index >= 6
                    const IconComponent = getChangeTypeIcon(key)
                    return (
                      <button
                        type="button"
                        class="facility-chip facility-chip--rose filter-tag"
                        data-filter-type="change_type"
                        data-filter-value={key}
                        data-extra-tag={isExtra ? 'true' : undefined}
                        hidden={isExtra ? true : undefined}
                        aria-pressed="false"
                      >
                        <span class="facility-chip-icon" aria-hidden="true">
                          <IconComponent size={15} />
                        </span>
                        <span class="facility-chip-label">{label}</span>
                        <span class="filter-tag-count">({count.toLocaleString('en-GB')})</span>
                      </button>
                    )
                  })}
                  {changeTypesList.length > 6 && (
                    <button
                      type="button"
                      class="filter-tag-more"
                      data-toggle-tags="change_type"
                      data-expanded="false"
                    >
                      View all ({changeTypesList.length})
                    </button>
                  )}
                </div>
              </div>

              <!-- Organisations -->
              <div class="filter-group">
                <p class="filter-group-heading">Sector Organisation</p>
                <div class="facility-chips filter-tag-list" data-tag-group="organisation">
                  {orgsList.map(({ key, label, count }, index) => {
                    const isExtra = index >= 6
                    const IconComponent = getOrgIcon(key)
                    return (
                      <button
                        type="button"
                        class="facility-chip facility-chip--green filter-tag"
                        data-filter-type="organisation"
                        data-filter-value={key}
                        data-extra-tag={isExtra ? 'true' : undefined}
                        hidden={isExtra ? true : undefined}
                        aria-pressed="false"
                      >
                        <span class="facility-chip-icon" aria-hidden="true">
                          <IconComponent size={15} />
                        </span>
                        <span class="facility-chip-label">{label}</span>
                        <span class="filter-tag-count">({count.toLocaleString('en-GB')})</span>
                      </button>
                    )
                  })}
                  {orgsList.length > 6 && (
                    <button
                      type="button"
                      class="filter-tag-more"
                      data-toggle-tags="organisation"
                      data-expanded="false"
                    >
                      View all ({orgsList.length})
                    </button>
                  )}
                </div>
              </div>

              <!-- Countries -->
              <div class="filter-group">
                <p class="filter-group-heading">Country</p>
                <div class="facility-chips filter-tag-list" data-tag-group="country">
                  {countriesList.map(({ key, label, count }, index) => {
                    const isExtra = index >= 4
                    return (
                      <button
                        type="button"
                        class="facility-chip facility-chip--apricot filter-tag"
                        data-filter-type="country"
                        data-filter-value={key}
                        data-extra-tag={isExtra ? 'true' : undefined}
                        hidden={isExtra ? true : undefined}
                        aria-pressed="false"
                      >
                        <span class="facility-chip-icon" aria-hidden="true">
                          <Globe size={15} />
                        </span>
                        <span class="facility-chip-label">{label}</span>
                        <span class="filter-tag-count">({count.toLocaleString('en-GB')})</span>
                      </button>
                    )
                  })}
                  {countriesList.length > 4 && (
                    <button
                      type="button"
                      class="filter-tag-more"
                      data-toggle-tags="country"
                      data-expanded="false"
                    >
                      View all ({countriesList.length})
                    </button>
                  )}
                </div>
              </div>

              <!-- Library Authority -->
              <div class="filter-group">
                <label for="authority-select" class="filter-group-heading">
                  Library Authority
                </label>
                <select id="authority-select" class="tab-filter-select">
                  <option value="">All Library Authorities ({authoritiesList.length})</option>
                  {authoritiesList.map(({ key, label, count }) => (
                    <option value={key}>
                      {label} ({count})
                    </option>
                  ))}
                </select>
              </div>
            </div>

            <!-- Popover Footer with Clear and Apply buttons matching libraries page -->
            <div class="tab-filter-footer">
              <button id="clear-panel-filters" class="button button-secondary" type="button">
                Clear all filters
              </button>
              <button id="apply-panel-filters" class="button" type="button">
                Apply filters
              </button>
            </div>
          </div>
        </div>

        <div id="active-filter-chips" class="active-filter-chips" aria-live="polite"></div>
      </div>

      <div id="news-context-links" class="news-context-links" hidden aria-live="polite"></div>
    </form>

    <section class="library-results-workspace" aria-labelledby="news-results-heading">
      <div class="results-heading">
        <h2 id="news-results-heading">News Stories</h2>
        <p id="news-result-count" aria-live="polite">
          Showing {defaultStoriesPool.length.toLocaleString('en-GB')} of{' '}
          {metadata.total_stories ? metadata.total_stories.toLocaleString('en-GB') : '38,000'}{' '}
          stories
        </p>
      </div>

      <div class="library-results-layout">
        <!-- Interactive Map Pane (first in DOM so stacked layout on mobile shows map on top) -->
        <NewsMap
          id="news-results-map"
          stories={initialMapStories}
          label="Mapped public libraries news stories"
        />

        <!-- Results Column (grid-column: 1 on desktop) -->
        <div class="library-results-column">
          <ul id="news-results-list" class="library-results news-results-list">
            {initialStories.map((story) => (
              <NewsCard story={story} />
            ))}
          </ul>

          <button id="load-more-news" class="load-more" type="button">
            Show more stories
          </button>
        </div>
      </div>
    </section>

    <script
      type="application/json"
      id="initial-news-data"
      set:html={JSON.stringify(defaultStoriesPool)}
    />
  </main>
</SiteLayout>

<script>
  import { autoUpdate, computePosition, flip, offset, shift } from '@floating-ui/dom'
  import {
    authorityPageUrl,
    categoryColor,
    categoryLabel,
    changeTypeLabel,
    matchesStoryQuery,
    organisationPageUrl
  } from '../../lib/content/newsFormatHelpers.mjs'
  import { createNewsStoryElement } from '../../scripts/newsListClient.mjs'

  let allStories = []
  let filteredStories = []
  let displayedCount = 30
  const PAGE_SIZE = 30

  const form = document.getElementById('news-filter-form')
  const searchInput = document.getElementById('news-search-query')
  const authoritySelect = document.getElementById('authority-select')
  const resultsContainer = document.getElementById('news-results-list')
  const resultCount = document.getElementById('news-result-count')
  const loadMoreBtn = document.getElementById('load-more-news')
  const resetBtn = document.getElementById('clear-all-filters')
  const newsMapEl = document.querySelector('news-map')
  const filterToggle = document.getElementById('news-filter-toggle')
  const filterPanel = document.getElementById('news-filter-panel')
  const filterCountBadge = document.getElementById('news-filter-count')
  const applyPanelBtn = document.getElementById('apply-panel-filters')
  const clearPanelBtn = document.getElementById('clear-panel-filters')
  const activeChipsContainer = document.getElementById('active-filter-chips')
  const contextLinksContainer = document.getElementById('news-context-links')
  const timeSlider = document.getElementById('news-time-slider')
  const timeSliderValue = document.getElementById('time-slider-value')
  const newsUrl = form?.dataset?.newsUrl || '/news.json'
  const baseUrl = form?.dataset?.baseUrl || '/'
  const totalArchiveCount = Number(form?.dataset?.totalStories || 38093)
  let authoritySlugsByName = {}
  try {
    authoritySlugsByName = JSON.parse(form?.dataset?.authoritySlugs || '{}')
  } catch {
    authoritySlugsByName = {}
  }

  // Sets to track active filter selections
  const selectedCats = new Set()
  const selectedChanges = new Set()
  const selectedOrgs = new Set()
  const selectedCountries = new Set()

  // Prevent default form submission on enter
  form?.addEventListener('submit', (e) => e.preventDefault())

  // Initialize from inline JSON data synchronously so pagination works immediately
  const rawInitialData = document.getElementById('initial-news-data')?.textContent
  if (rawInitialData) {
    try {
      allStories = JSON.parse(rawInitialData)
      filteredStories = allStories
      if (loadMoreBtn) {
        loadMoreBtn.hidden = displayedCount >= filteredStories.length
      }
    } catch (err) {
      console.warn('Failed parsing initial news data:', err)
    }
  }

  const TIME_STEPS = {
    '1': { label: 'Past year', years: 1 },
    '2': { label: 'Past 2 years', years: 2 },
    '3': { label: 'Past 3 years', years: 3 },
    '4': { label: 'Past 5 years', years: 5 },
    '5': { label: 'All time', years: 0, isAll: true }
  }

  const ARCHIVE_EXTENSIONS = [
    {
      id: '2020-2022',
      minYear: 2020,
      maxYear: 2022,
      url: '/news/archive/2020-2022.json'
    },
    {
      id: '2015-2019',
      minYear: 2015,
      maxYear: 2019,
      url: '/news/archive/2015-2019.json'
    },
    {
      id: '2010-2014',
      minYear: 2010,
      maxYear: 2014,
      url: '/news/archive/2010-2014.json'
    }
  ]
  const loadedExtensions = new Set()
  let isFetchingExtension = false

  async function loadExtension(ext) {
    if (loadedExtensions.has(ext.id)) return
    loadedExtensions.add(ext.id)
    try {
      const res = await fetch(ext.url)
      if (res.ok) {
        const stories = await res.json()
        const existingIds = new Set(allStories.map((s) => s.id))
        for (const s of stories) {
          if (!existingIds.has(s.id)) {
            allStories.push(s)
            existingIds.add(s.id)
          }
        }
        allStories.sort((a, b) => (b.date || '').localeCompare(a.date || ''))
      }
    } catch (err) {
      console.warn(`Failed loading archive ${ext.id}:`, err)
    }
  }

  async function ensureExtensionsForRange(minDate, isAll = false) {
    if (isFetchingExtension) return
    const needed = ARCHIVE_EXTENSIONS.filter((ext) => {
      if (loadedExtensions.has(ext.id)) return false
      if (isAll) return true
      if (!minDate) return false
      const minYear = parseInt(minDate.slice(0, 4), 10)
      return minYear <= ext.maxYear
    })
    if (needed.length === 0) return

    isFetchingExtension = true
    for (const ext of needed) {
      await loadExtension(ext)
    }
    isFetchingExtension = false
    applyFilters()
  }

  // Popover positioning using Floating UI autoUpdate identical to directory page
  if (filterPanel && filterToggle) {
    let cleanup
    filterPanel.addEventListener('beforetoggle', () =>
      filterPanel.removeAttribute('data-positioned')
    )
    filterPanel.addEventListener('toggle', () => {
      const open = filterPanel.matches(':popover-open')
      filterToggle.setAttribute('aria-expanded', String(open))
      cleanup?.()
      cleanup = open
        ? autoUpdate(filterToggle, filterPanel, () => {
            computePosition(filterToggle, filterPanel, {
              strategy: 'fixed',
              placement: 'bottom-start',
              middleware: [offset(8), flip(), shift({ padding: 12, crossAxis: true })]
            }).then(({ x, y }) => {
              if (!filterPanel.matches(':popover-open')) return
              Object.assign(filterPanel.style, { left: `${x}px`, top: `${y}px` })
              filterPanel.setAttribute('data-positioned', 'true')
            })
          })
        : undefined
    })
  }

  function formatDate(str) {
    if (!str) return ''
    try {
      const d = new Date(str)
      if (isNaN(d.getTime())) return str
      return d.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      })
    } catch {
      return str
    }
  }

  async function loadIndex() {
    try {
      const res = await fetch(newsUrl)
      if (res.ok) {
        const fullIndex = await res.json()
        const existingMap = new Map(allStories.map((s) => [s.id, s]))
        for (const s of fullIndex) {
          existingMap.set(s.id, s)
        }
        allStories = Array.from(existingMap.values())
        allStories.sort((a, b) => (b.date || '').localeCompare(a.date || ''))

        const urlParams = new URLSearchParams(window.location.search)
        const paramAuth = urlParams.get('authority')
        const paramOrg = urlParams.get('organisation')
        const paramCat = urlParams.get('category')
        const paramChange = urlParams.get('change_type')
        const paramQ = urlParams.get('q')
        const paramRange = urlParams.get('range')
        const paramAll = urlParams.get('all')

        if (paramAuth && authoritySelect) authoritySelect.value = paramAuth
        if (paramQ && searchInput) searchInput.value = paramQ
        if (paramOrg) {
          selectedOrgs.add(paramOrg)
        }
        if (paramCat) {
          paramCat
            .split(',')
            .map((v) => v.trim())
            .filter(Boolean)
            .forEach((v) => selectedCats.add(v))
        }
        if (paramChange) {
          paramChange
            .split(',')
            .map((v) => v.trim())
            .filter(Boolean)
            .forEach((v) => selectedChanges.add(v))
        }

        if (paramRange) {
          const rangeMap = { '1y': '1', '2y': '2', '3y': '3', '5y': '4', all: '5' }
          if (timeSlider && rangeMap[paramRange]) {
            timeSlider.value = rangeMap[paramRange]
          }
        }
        if (paramAll === 'true' && timeSlider) {
          timeSlider.value = '5'
        }

        syncTagButtons()
        applyFilters()
      }
    } catch (err) {
      console.warn('Error loading news index:', err)
    }
  }

  function updateActiveChips(activeFilters) {
    if (!activeChipsContainer) return
    activeChipsContainer.innerHTML = ''
    const fragment = document.createDocumentFragment()

    const crossSvg =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'

    activeFilters.forEach(({ label, color = 'plum', type, value }) => {
      const chip = document.createElement('button')
      chip.type = 'button'
      chip.className = `active-chip active-chip--${color}`
      chip.setAttribute('aria-label', `Remove filter: ${label}`)
      chip.innerHTML = `<span>${escapeHtml(label)}</span>${crossSvg}`

      chip.addEventListener('click', () => {
        if (type === 'category') selectedCats.delete(value)
        else if (type === 'change') selectedChanges.delete(value)
        else if (type === 'org') selectedOrgs.delete(value)
        else if (type === 'country') selectedCountries.delete(value)
        else if (type === 'authority') {
          if (authoritySelect) authoritySelect.value = ''
        } else if (type === 'date') {
          if (timeSlider) {
            timeSlider.value = '1'
            if (timeSliderValue) timeSliderValue.textContent = 'Past year'
          }
        }
        syncTagButtons()
        applyFilters()
      })

      fragment.appendChild(chip)
    })

    activeChipsContainer.appendChild(fragment)
  }

  function syncTagButtons() {
    for (const btn of form.querySelectorAll('.filter-tag[data-filter-type]')) {
      const type = btn.dataset.filterType
      const val = btn.dataset.filterValue
      let active = false
      if (type === 'category') active = selectedCats.has(val)
      else if (type === 'change_type') active = selectedChanges.has(val)
      else if (type === 'organisation') active = selectedOrgs.has(val)
      else if (type === 'country') active = selectedCountries.has(val)

      btn.setAttribute('aria-pressed', active ? 'true' : 'false')
      if (active) btn.hidden = false
    }

    const activeCount =
      selectedCats.size +
      selectedChanges.size +
      selectedOrgs.size +
      selectedCountries.size +
      (authoritySelect?.value ? 1 : 0) +
      (timeSlider?.value !== '1' ? 1 : 0)

    if (filterCountBadge) {
      filterCountBadge.textContent = String(activeCount)
      filterCountBadge.hidden = activeCount === 0
    }
  }

  // Tag button click listeners
  for (const btn of form.querySelectorAll('.filter-tag[data-filter-type]')) {
    btn.addEventListener('click', () => {
      const type = btn.dataset.filterType
      const val = btn.dataset.filterValue
      let targetSet
      if (type === 'category') targetSet = selectedCats
      else if (type === 'change_type') targetSet = selectedChanges
      else if (type === 'organisation') targetSet = selectedOrgs
      else if (type === 'country') targetSet = selectedCountries
      if (!targetSet) return

      if (targetSet.has(val)) {
        targetSet.delete(val)
      } else {
        targetSet.add(val)
      }
      syncTagButtons()
      applyFilters()
    })
  }

  // "View all" expandable groups toggle
  for (const button of form.querySelectorAll('[data-toggle-tags]')) {
    button.addEventListener('click', () => {
      const groupName = button.dataset.toggleTags
      const group = form.querySelector(`[data-tag-group="${groupName}"]`)
      if (!group) return
      const expanded = button.dataset.expanded === 'true'
      for (const tag of group.querySelectorAll('[data-extra-tag="true"]')) {
        if (!expanded) {
          tag.hidden = false
        } else if (tag.getAttribute('aria-pressed') !== 'true') {
          tag.hidden = true
        }
      }
      button.dataset.expanded = expanded ? 'false' : 'true'
      const totalCount = group.querySelectorAll('.filter-tag').length
      button.textContent = expanded ? `View all (${totalCount})` : 'Show less'
    })
  }

  function applyFilters() {
    if (!allStories || allStories.length === 0) return

    const query = (searchInput?.value || '').toLowerCase().trim()
    const selectedAuthority = authoritySelect?.value || ''

    const sliderVal = timeSlider?.value || '1'
    const timeStep = TIME_STEPS[sliderVal] || TIME_STEPS['1']
    if (timeSliderValue) timeSliderValue.textContent = timeStep.label

    let minDate = ''
    let maxDate = ''
    let dateLabel = timeStep.label

    const anchorDateStr = allStories[0]?.date || new Date().toISOString().slice(0, 10)
    const anchorDate = new Date(anchorDateStr)

    if (timeStep.years > 0) {
      const d = new Date(anchorDate)
      d.setFullYear(d.getFullYear() - timeStep.years)
      minDate = d.toISOString().slice(0, 10)
    }

    const isAllTime = Boolean(timeStep.isAll)
    if (isAllTime || (minDate && minDate < '2023-01-01')) {
      ensureExtensionsForRange(minDate, isAllTime)
    }

    // Calculate active filter count and chips
    const activeFilters = []
    if (sliderVal !== '1') {
      activeFilters.push({
        label: `Date: ${dateLabel}`,
        color: 'plum',
        type: 'date',
        value: sliderVal
      })
    }
    selectedCats.forEach((c) =>
      activeFilters.push({
        label: categoryLabel(c),
        color: categoryColor(c),
        type: 'category',
        value: c
      })
    )
    selectedChanges.forEach((c) =>
      activeFilters.push({
        label: changeTypeLabel(c),
        color: 'rose',
        type: 'change',
        value: c
      })
    )
    selectedOrgs.forEach((o) =>
      activeFilters.push({
        label: o,
        color: 'green',
        type: 'org',
        value: o
      })
    )
    selectedCountries.forEach((c) =>
      activeFilters.push({
        label: c,
        color: 'apricot',
        type: 'country',
        value: c
      })
    )
    if (selectedAuthority) {
      activeFilters.push({
        label: selectedAuthority,
        color: 'plum',
        type: 'authority',
        value: selectedAuthority
      })
    }

    syncTagButtons()
    updateActiveChips(activeFilters)
    updateContextLinks(selectedAuthority, selectedOrgs)

    filteredStories = allStories.filter((story) => {
      const storyDate = story.date || ''
      if (minDate && storyDate && storyDate < minDate) return false
      if (maxDate && storyDate && storyDate > maxDate) return false

      if (query && !matchesStoryQuery(story, query)) {
        return false
      }

      if (selectedCats.size > 0) {
        const matchesCat = (story.categories || []).some((c) => selectedCats.has(c))
        if (!matchesCat) return false
      }

      if (selectedChanges.size > 0) {
        if (!selectedChanges.has(story.change_type)) return false
      }

      if (selectedOrgs.size > 0) {
        const matchesOrg = (story.organisations || []).some((o) => selectedOrgs.has(o))
        if (!matchesOrg) return false
      }

      if (selectedCountries.size > 0) {
        if (!selectedCountries.has(story.country)) return false
      }

      if (selectedAuthority) {
        if (story.authority_name !== selectedAuthority) return false
      }

      return true
    })

    displayedCount = PAGE_SIZE
    renderResults()
    updateMap()
  }

  function updateContextLinks(selectedAuthority, selectedOrgsSet) {
    if (!contextLinksContainer) return
    contextLinksContainer.innerHTML = ''
    const items = []

    if (selectedAuthority) {
      const slug = authoritySlugsByName[selectedAuthority]
      const href = authorityPageUrl(slug, baseUrl)
      if (href) {
        items.push({
          prefix: 'Authority directory:',
          label: `${selectedAuthority} libraries & profile →`,
          href
        })
      }
    }

    for (const orgName of selectedOrgsSet) {
      const href = organisationPageUrl(orgName, baseUrl)
      if (href) {
        items.push({
          prefix: 'Stakeholder profile:',
          label: `${orgName} overview & remit →`,
          href
        })
      }
    }

    if (items.length === 0) {
      contextLinksContainer.hidden = true
      return
    }

    const fragment = document.createDocumentFragment()
    for (const item of items) {
      const wrap = document.createElement('span')
      wrap.className = 'news-context-link-item'
      const prefixSpan = document.createElement('span')
      prefixSpan.className = 'news-context-link-prefix'
      prefixSpan.textContent = item.prefix
      const a = document.createElement('a')
      a.href = item.href
      a.className = 'news-context-link'
      a.textContent = item.label
      wrap.appendChild(prefixSpan)
      wrap.appendChild(a)
      fragment.appendChild(wrap)
    }

    contextLinksContainer.appendChild(fragment)
    contextLinksContainer.hidden = false
  }

  function createStoryElement(story) {
    return createNewsStoryElement(story, { baseUrl })
  }

  function renderResults() {
    if (!resultCount || !resultsContainer || !loadMoreBtn) return
    const visible = filteredStories.slice(0, displayedCount)

    resultCount.textContent = `Showing ${filteredStories.length.toLocaleString('en-GB')} of ${totalArchiveCount.toLocaleString('en-GB')} stories`

    resultsContainer.innerHTML = ''
    if (visible.length === 0) {
      resultsContainer.innerHTML =
        '<li class="news-empty-message">No news stories match the current filters.</li>'
      loadMoreBtn.hidden = true
      return
    }

    const fragment = document.createDocumentFragment()
    visible.forEach((story) => {
      fragment.appendChild(createStoryElement(story))
    })
    resultsContainer.appendChild(fragment)

    loadMoreBtn.hidden = displayedCount >= filteredStories.length
  }

  function appendMoreStories() {
    if (!resultCount || !resultsContainer || !loadMoreBtn) return
    const prevCount = displayedCount
    displayedCount = Math.min(displayedCount + PAGE_SIZE, filteredStories.length)
    const nextSlice = filteredStories.slice(prevCount, displayedCount)
    const fragment = document.createDocumentFragment()
    nextSlice.forEach((story) => {
      fragment.appendChild(createStoryElement(story))
    })
    resultsContainer.appendChild(fragment)

    loadMoreBtn.hidden = displayedCount >= filteredStories.length
  }

  function updateMap() {
    if (newsMapEl) {
      const mapped = filteredStories.filter(
        (s) => typeof s.lat === 'number' && typeof s.lng === 'number'
      )
      newsMapEl.dispatchEvent(new CustomEvent('news-map-update', { detail: { stories: mapped } }))
    }
  }

  function resetAllFilters() {
    selectedCats.clear()
    selectedChanges.clear()
    selectedOrgs.clear()
    selectedCountries.clear()
    if (searchInput) searchInput.value = ''
    if (authoritySelect) authoritySelect.value = ''
    if (timeSlider) timeSlider.value = '1'
    if (timeSliderValue) timeSliderValue.textContent = 'Past year'
    syncTagButtons()
    applyFilters()
  }

  let searchTimer
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer)
    searchTimer = setTimeout(applyFilters, 250)
  })

  authoritySelect?.addEventListener('change', applyFilters)

  timeSlider?.addEventListener('input', () => {
    const step = TIME_STEPS[timeSlider.value] || TIME_STEPS['1']
    if (timeSliderValue) timeSliderValue.textContent = step.label
    applyFilters()
  })

  timeSlider?.addEventListener('change', applyFilters)

  applyPanelBtn?.addEventListener('click', () => {
    if (filterPanel?.matches(':popover-open')) filterPanel.hidePopover()
    applyFilters()
  })

  clearPanelBtn?.addEventListener('click', () => {
    selectedCats.clear()
    selectedChanges.clear()
    selectedOrgs.clear()
    selectedCountries.clear()
    if (authoritySelect) authoritySelect.value = ''
    if (timeSlider) timeSlider.value = '1'
    if (timeSliderValue) timeSliderValue.textContent = 'Past year'
    syncTagButtons()
    applyFilters()
  })

  loadMoreBtn?.addEventListener('click', () => {
    appendMoreStories()
  })

  resetBtn?.addEventListener('click', resetAllFilters)

  window.addEventListener('news-select-location', (event) => {
    const auth = event.detail?.authority
    if (auth && authoritySelect) {
      authoritySelect.value = auth
      applyFilters()
      const heading = document.getElementById('news-results-heading')
      heading?.scrollIntoView({ behavior: 'smooth' })
    }
  })

  loadIndex()
</script>
