---
import { getCollection } from 'astro:content'
import { ArrowUpRight, Newspaper } from '@lucide/astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import StatusPill from '../../components/StatusPill.astro'
import {
  getNewsForOrganisation,
  getNewsSummaryForOrganisation
} from '../../lib/helpers/newsHelpers.mjs'
import { settings, sitePath } from '../../lib/helpers/siteHelpers.mjs'

const organisations = (await getCollection('organisations')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en')
)
---

<SiteLayout
  title="Library Organisations | LibraryCommons"
  description="Directory of national bodies, government departments, charities, and associations shaping public library services."
>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs
        items={[
          { label: settings.ui.editorial?.home_breadcrumb || 'Home', href: '/' },
          { label: 'Organisations', current: true }
        ]}
      />
      <p class="eyebrow">Sector Leadership & Governance</p>
      <h1>Library Organisations</h1>
      <p>
        Key national bodies, government departments, professional associations, unions, and user
        campaigns supporting and shaping public libraries across the United Kingdom.
      </p>
    </div>
  </header>

  <main class="section shell">
    <div class="article-grid">
      {organisations.map((org) => {
        const stories = getNewsForOrganisation(org.data.slug)
        const summary = getNewsSummaryForOrganisation(org.data.slug)
        const totalStories = summary?.total ?? stories.length
        const coverage =
          summary?.first_year && summary?.latest_year
            ? ` (${summary.first_year}–${summary.latest_year})`
            : ''
        return (
          <a
            class="content-card org-content-card"
            href={sitePath(`/organisations/${org.data.slug}/`)}
          >
            <div class="content-card-body">
              <div class="org-card-pills">
                {org.data.acronym && <StatusPill variant="plum">{org.data.acronym}</StatusPill>}
                {org.data.country && <StatusPill variant="apricot">{org.data.country}</StatusPill>}
              </div>

              <h2 class="content-card-heading">
                <span>{org.data.name}</span>
                <ArrowUpRight class="content-card-arrow" size={20} aria-hidden="true" />
              </h2>

              {org.data.role && <p class="org-card-role">{org.data.role}</p>}

              {org.data.description && <p class="org-card-desc">{org.data.description}</p>}

              <div class="org-card-footer">
                <StatusPill variant="green">
                  <Newspaper size={14} aria-hidden="true" />
                  <span>
                    {totalStories.toLocaleString('en-GB')} news stories{coverage}
                  </span>
                </StatusPill>
              </div>
            </div>
          </a>
        )
      })}
    </div>
  </main>
</SiteLayout>
