---
import { getCollection, getEntry, render } from 'astro:content'
import { ArrowUpRight, Building2, Newspaper } from '@lucide/astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import StatusPill from '../../components/StatusPill.astro'
import {
  getNewsForOrganisation,
  getNewsSummaryForOrganisation
} from '../../lib/content/newsHelpers.mjs'
import { settings, sitePath } from '../../lib/site/siteHelpers.mjs'
import { authorities } from '../../lib/directory/directoryLoader.mjs'

const orgPage = await getEntry('pages', 'organisations')
const { Content } = orgPage ? await render(orgPage) : { Content: null }
const title = orgPage?.data.title || 'Library Stakeholders'
const description =
  orgPage?.data.description ||
  'Directory of national bodies, local authorities, charities, and public communities shaping and supporting UK public libraries.'
const eyebrow = orgPage?.data.eyebrow || 'Leadership, Governance & Community'

const organisations = (await getCollection('organisations')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en')
)
---

<SiteLayout title={`${title} | ${settings.site.title}`} description={description}>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs
        items={[
          { label: settings.ui.editorial?.home_breadcrumb || 'Home', href: '/' },
          { label: title, current: true }
        ]}
      />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {Content ? (
        <div class="page-intro">
          <Content />
        </div>
      ) : (
        <p>{description}</p>
      )}
    </div>
  </header>

  <main class="section shell">
    <div class="article-grid">
      {organisations.map((org) => {
        const isExcludedFromNews = ['local-authorities', 'the-public'].includes(org.data.slug)
        const stories = isExcludedFromNews ? [] : getNewsForOrganisation(org.data.slug)
        const summary = isExcludedFromNews ? null : getNewsSummaryForOrganisation(org.data.slug)
        const totalStories = summary?.total ?? stories.length
        const coverage =
          summary?.first_year && summary?.latest_year
            ? ` (${summary.first_year}–${summary.latest_year})`
            : ''
        const isLocalAuthorities = org.data.slug === 'local-authorities'
        const hasFooter = totalStories > 0 || isLocalAuthorities

        return (
          <a
            class="content-card org-content-card"
            href={sitePath(`/organisations/${org.data.slug}/`)}
          >
            <div class="content-card-body">
              <div class="org-card-pills">
                {org.data.acronym && <StatusPill variant="plum">{org.data.acronym}</StatusPill>}
                {org.data.country && <StatusPill variant="apricot">{org.data.country}</StatusPill>}
              </div>

              <h2 class="content-card-heading">
                <span>{org.data.name}</span>
                <ArrowUpRight class="content-card-arrow" size={20} aria-hidden="true" />
              </h2>

              {org.data.role && <p class="org-card-role">{org.data.role}</p>}

              {org.data.description && <p class="org-card-desc">{org.data.description}</p>}

              {hasFooter && (
                <div class="org-card-footer">
                  {totalStories > 0 ? (
                    <StatusPill variant="green">
                      <Newspaper size={14} aria-hidden="true" />
                      <span>
                        {totalStories.toLocaleString('en-GB')} news stories{coverage}
                      </span>
                    </StatusPill>
                  ) : isLocalAuthorities ? (
                    <StatusPill variant="green">
                      <Building2 size={14} aria-hidden="true" />
                      <span>{authorities.length} statutory authorities</span>
                    </StatusPill>
                  ) : null}
                </div>
              )}
            </div>
          </a>
        )
      })}
    </div>
  </main>
</SiteLayout>
