---
import { getCollection } from 'astro:content';
import ResourceTemplate from '../../templates/ResourceTemplate.astro';
import { resourceUsage } from '../../lib/resource-usage.mjs';
export async function getStaticPaths() {
  const [resources, pages, sessions] = await Promise.all([
    getCollection('resources'),
    getCollection('pages'),
    getCollection('sessions'),
  ]);
  const usage = resourceUsage(resources, pages, sessions);
  return resources.map((entry) => ({
    params: { resource: entry.id },
    props: { resource: entry.data, usage: usage.get(entry.id) || [] }
  }));
}
---

<ResourceTemplate {...Astro.props} />
