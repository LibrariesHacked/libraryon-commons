---
import { getCollection } from 'astro:content'

import ResourceLink from '../../components/ResourceLink.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { resourceUsage } from '../../lib/content/resourceHelpers.mjs'
import { normalise } from '../../lib/directory/searchHelpers.mjs'
import { settings, sitePath } from '../../lib/site/siteHelpers.mjs'
const copy = settings.ui.resource_page
const kindLabels = {
  document: copy.documents,
  slides: copy.slides,
  recording: copy.recordings,
  link: copy.useful_link
}

const resources = (await getCollection('resources')).sort((first, second) => {
  const firstLocal = first.data.url.startsWith('/uploads/')
  const secondLocal = second.data.url.startsWith('/uploads/')
  return (
    Number(secondLocal) - Number(firstLocal) ||
    first.data.title.localeCompare(second.data.title, 'en')
  )
})
const usage = resourceUsage(
  resources,
  await getCollection('pages'),
  await getCollection('sessions')
)
---

<SiteLayout title={copy.title} description={copy.description}>
  <header class="page-heading">
    <div class="shell">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
    </div>
  </header>
  <section class="section shell">
    <div
      class="filter-bar"
      data-singular={copy.singular}
      data-plural={copy.plural}
      data-page-size="24"
      data-page-status={copy.pagination_status}
    >
      <label>
        {copy.search_label}
        <input id="resource-query" type="search" placeholder={copy.search_placeholder} />
      </label>
      <label>
        {copy.type_label}
        <select id="resource-kind">
          <option value="">{copy.all_resources}</option>
          <option value="document">{copy.documents}</option>
          <option value="slides">{copy.slides}</option>
          <option value="recording">{copy.recordings}</option>
          <option value="link">{copy.links}</option>
        </select>
      </label>
      <label>
        {copy.location_label}
        <select id="resource-location">
          <option value="">{copy.all_locations}</option>
          <option value="local">{copy.saved_downloads}</option>
          <option value="external">{copy.external_links}</option>
        </select>
      </label>
    </div>
    <p id="resource-count" class="muted" role="status" aria-live="polite">
      {resources.length} {copy.plural}
    </p>
    <nav
      class="resource-pagination"
      id="resource-pagination"
      aria-label={copy.pagination_label}
      hidden
    >
      <button class="button button-secondary" id="resource-previous" type="button">
        {copy.previous_page}
      </button>
      <p id="resource-page-status" role="status" aria-live="polite"></p>
      <button class="button button-secondary" id="resource-next" type="button">
        {copy.next_page}
      </button>
    </nav>
    <ul class="resource-list" id="resource-results">
      {resources.map(({ id, data }) => (
        <li
          data-search={normalise(
            `${data.title} ${data.description || ''} ${(usage.get(id) || []).map((reference) => reference.label).join(' ')}`
          )}
          data-kind={data.kind}
          data-location={data.url.startsWith('/uploads/') ? 'local' : 'external'}
        >
          <ResourceLink resource={data} />
          <p class="resource-meta">
            <a href={sitePath(`/resources/${id}/`)}>{copy.details_link}</a>
          </p>
          {data.description && <p>{data.description}</p>}
          {usage.get(id)?.length > 0 && (
            <p class="resource-usage">
              <span>{settings.ui.resources.used_in}</span>
              {usage.get(id).map((reference) => (
                <a href={sitePath(reference.href)}>{reference.label}</a>
              ))}
            </p>
          )}
          <div class="resource-meta">
            {kindLabels[data.kind]} ·{' '}
            {data.url.startsWith('/uploads/') ? copy.saved_copy : copy.external_resource}
            {data.credit && ` · ${data.credit}`}
            {data.licence && ` · ${data.licence}`}
          </div>
        </li>
      ))}
    </ul>
    <p id="resource-empty" class="empty-state" hidden>
      {copy.no_matches}
    </p>
  </section>
</SiteLayout>

<script>
  import { normalise } from '../../lib/directory/searchHelpers.mjs'
  const query = document.querySelector<HTMLInputElement>('#resource-query')
  const kind = document.querySelector<HTMLSelectElement>('#resource-kind')
  const location = document.querySelector<HTMLSelectElement>('#resource-location')
  const entries = [...document.querySelectorAll<HTMLElement>('#resource-results > li')]
  const count = document.querySelector<HTMLElement>('#resource-count')
  const empty = document.querySelector<HTMLElement>('#resource-empty')
  const filterBar = document.querySelector<HTMLElement>('.filter-bar')
  const pagination = document.querySelector<HTMLElement>('#resource-pagination')
  const previous = document.querySelector<HTMLButtonElement>('#resource-previous')
  const next = document.querySelector<HTMLButtonElement>('#resource-next')
  const pageStatus = document.querySelector<HTMLElement>('#resource-page-status')
  const pageSize = Number(filterBar.dataset.pageSize)
  let currentPage = 1

  function filterResources() {
    const terms = normalise(query.value).split(/\s+/)
    const matches = entries.filter(
      (entry) =>
        terms.every((term) => entry.dataset.search.includes(term)) &&
        (!kind.value || entry.dataset.kind === kind.value) &&
        (!location.value || entry.dataset.location === location.value)
    )
    const pageCount = Math.max(1, Math.ceil(matches.length / pageSize))
    currentPage = Math.min(currentPage, pageCount)
    const first = (currentPage - 1) * pageSize
    const visibleEntries = new Set(matches.slice(first, first + pageSize))
    for (const entry of entries) entry.hidden = !visibleEntries.has(entry)
    count.textContent = `${matches.length} ${matches.length === 1 ? filterBar.dataset.singular : filterBar.dataset.plural}`
    empty.hidden = matches.length !== 0
    pagination.hidden = pageCount <= 1
    previous.disabled = currentPage <= 1
    next.disabled = currentPage >= pageCount
    pageStatus.textContent = filterBar.dataset.pageStatus
      .replace('{page}', String(currentPage))
      .replace('{pages}', String(pageCount))
  }
  query.addEventListener('input', () => {
    currentPage = 1
    filterResources()
  })
  const resetPageAndFilter = () => {
    currentPage = 1
    filterResources()
  }
  kind.addEventListener('change', resetPageAndFilter)
  location.addEventListener('change', resetPageAndFilter)
  previous.addEventListener('click', () => {
    currentPage -= 1
    filterResources()
  })
  next.addEventListener('click', () => {
    currentPage += 1
    filterResources()
  })
  filterResources()
</script>
