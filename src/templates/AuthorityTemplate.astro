---
import { ArrowUpRight } from '@lucide/astro'

import ContactDetails from '../components/ContactDetails.astro'
import DirectoryProvenance from '../components/DirectoryProvenance.astro'
import LibraryMap from '../components/LibraryMap.astro'
import LibrarySearch from '../components/LibrarySearch.astro'
import LibraryDownloads from '../components/LibraryDownloads.astro'
import ShareButtons from '../components/ShareButtons.astro'
import SocialLinks from '../components/SocialLinks.astro'
import TagListSection from '../components/TagListSection.astro'
import AuthorityActivity from '../components/AuthorityActivity.astro'
import NewsList from '../components/NewsList.astro'
import DirectoryLayout from '../layouts/DirectoryLayout.astro'
import { collectValues, facilityLabel } from '../lib/directory/dataHelpers.mjs'
import { settings, sitePath } from '../lib/site/siteHelpers.mjs'
import { getNewsForAuthority, getNewsSummaryForAuthority } from '../lib/content/newsHelpers.mjs'
import { formatActivityPeriod, getActivityForAuthority } from '../lib/content/activityHelpers.mjs'

const { authority, entries = [] } = Astro.props
const copy = settings.ui.directory
const activityData = getActivityForAuthority(authority.gss)
const newsStories = getNewsForAuthority(authority.gss, authority.slug, authority.name)
const newsSummary = getNewsSummaryForAuthority(authority.gss, authority.slug, authority.name)
const hasNews = newsStories.length > 0 || (newsSummary && newsSummary.total > 0)
const totalNewsCount = newsSummary?.total ?? newsStories.length

const activeEntries = entries.filter((library) => !library.permanentlyClosed)
const closedEntries = entries.filter((library) => library.permanentlyClosed)
const hasClosedLibraries = closedEntries.length > 0

const activeForSummary = activeEntries.length > 0 ? activeEntries : entries
const services = collectValues(activeForSummary, (library) =>
  library.services?.map((item) => item.service)
)
const accessibility = collectValues(activeForSummary, (library) => library.accessibility)

const librariesSubtitle = `${activeEntries.length} ${copy.libraries_heading.toLowerCase()}${hasClosedLibraries ? ` · ${closedEntries.length} closed` : ''}${services.length ? ` · ${services.length} ${copy.services_count}` : ''}${authority.country ? ` · ${authority.country}` : ''}`
const heroTags = [
  authority.country,
  `${activeEntries.length} ${copy.libraries_heading.toLowerCase()}`,
  hasClosedLibraries ? `${closedEntries.length} closed` : '',
  activityData
    ? {
        label: `Activity data (${formatActivityPeriod(activityData.period)})`,
        href: '#authority-activity-heading'
      }
    : null,
  hasNews && totalNewsCount > 0
    ? {
        label: `${totalNewsCount.toLocaleString('en-GB')} news ${totalNewsCount === 1 ? 'story' : 'stories'}`,
        href: '#news-list-heading'
      }
    : null
].filter(Boolean)
---

<DirectoryLayout
  title={authority.name}
  subtitle={librariesSubtitle}
  description={`${copy.authority_description_prefix} ${authority.name}.`}
  tags={heroTags}
>
  <LibrarySearch />

  <div class="authority-libraries-heading-row">
    <h2>{copy.libraries_heading}</h2>
    {hasClosedLibraries && (
      <label class="search-option-toggle authority-closed-toggle" for="authority-include-closed">
        <span>Include permanently closed libraries</span>
        <input id="authority-include-closed" type="checkbox" />
      </label>
    )}
  </div>

  <LibraryMap libraries={entries} label={`Libraries in ${authority.name}`} />

  {hasClosedLibraries && (
    <script
      type="application/json"
      id="authority-map-data"
      set:html={JSON.stringify({ active: activeEntries, all: entries }).replace(/</g, '\\u003c')}
    />
  )}

  <ul class="library-results" data-library-list>
    {entries.map((library) => (
      <li
        data-hours={JSON.stringify(library.hours || library.openingTimes || null)}
        data-permanently-closed={library.permanentlyClosed ? 'true' : undefined}
        hidden={library.permanentlyClosed ? true : undefined}
      >
        <div class="library-result-header">
          <h3>
            <a href={sitePath(library.url)}>
              {library.name} <ArrowUpRight size={17} aria-hidden="true" />
            </a>
          </h3>
          <span class="live-status-pill live-status-pill--small" data-open-status />
        </div>
        <p>{library.address}</p>
        {library.permanentlyClosed && <p class="notice">{copy.marked_permanently_closed}</p>}
      </li>
    ))}
  </ul>

  <TagListSection heading={copy.services_heading} items={services} />
  <TagListSection
    heading={copy.accessibility}
    items={accessibility.map((value) => facilityLabel(value))}
  />

  {activityData && <AuthorityActivity activity={activityData} authority={authority} />}

  {hasNews && (
    <NewsList
      stories={newsStories}
      summary={newsSummary}
      title={`Public Libraries News for ${authority.name}`}
      subtitle="Recent news, changes, and service updates reported in Public Libraries News."
    />
  )}

  <LibraryDownloads entries={entries} authoritySlug={authority.slug} />

  <ShareButtons
    title={`${authority.name} Libraries`}
    description={`${copy.authority_description_prefix} ${authority.name}.`}
    heading="Share this directory"
  />

  <Fragment slot="aside">
    <section class="detail-section">
      <h2>{copy.library_service}</h2>
      <ContactDetails record={authority} />
    </section>
    {authority.about && (
      <section class="detail-section">
        <h2>{copy.about_service}</h2>
        <p>{authority.about}</p>
      </section>
    )}
    <SocialLinks heading={copy.connect} links={authority.social} />
    <DirectoryProvenance record={authority} />
  </Fragment>
</DirectoryLayout>

<script>
  import { updateLibraryListStatus } from '../lib/directory/openingHoursHelpers.mjs'

  updateLibraryListStatus()

  const closedToggle = document.getElementById('authority-include-closed')
  if (closedToggle) {
    closedToggle.addEventListener('change', () => {
      const showClosed = closedToggle.checked
      const closedItems = document.querySelectorAll('[data-permanently-closed="true"]')
      for (const item of closedItems) {
        item.hidden = !showClosed
      }

      const mapDataEl = document.getElementById('authority-map-data')
      const mapEl = document.querySelector('library-map')
      if (mapDataEl && mapEl) {
        try {
          const { active, all } = JSON.parse(mapDataEl.textContent)
          const records = showClosed ? all : active
          mapEl.dispatchEvent(new CustomEvent('library-map-update', { detail: { records } }))
        } catch {
          // Ignore JSON parse errors silently
        }
      }

      if (showClosed) {
        updateLibraryListStatus()
      }
    })
  }
</script>
