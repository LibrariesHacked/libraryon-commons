---
import { ArrowUpRight } from '@lucide/astro'

import ContactDetails from '../components/ContactDetails.astro'
import DirectoryProvenance from '../components/DirectoryProvenance.astro'
import LibraryMap from '../components/LibraryMap.astro'
import LibrarySearch from '../components/LibrarySearch.astro'
import LibraryDownloads from '../components/LibraryDownloads.astro'
import SocialLinks from '../components/SocialLinks.astro'
import TagListSection from '../components/TagListSection.astro'
import DirectoryLayout from '../layouts/DirectoryLayout.astro'
import { collectValues, facilityLabel } from '../lib/directory.mjs'
import { settings, sitePath } from '../lib/site.mjs'
const { authority, entries } = Astro.props
const copy = settings.ui.directory
const services = collectValues(entries, (library) => library.services?.map((item) => item.service))
const accessibility = collectValues(entries, (library) => library.accessibility)
---

<DirectoryLayout
  title={authority.name}
  subtitle={`${entries.length} ${copy.libraries_heading.toLowerCase()}${services.length ? ` · ${services.length} ${copy.services_count}` : ''}${authority.country ? ` · ${authority.country}` : ''}`}
  description={`${copy.authority_description_prefix} ${authority.name}.`}
>
  <LibrarySearch />
  <h2>{copy.libraries_heading}</h2>
  <LibraryMap libraries={entries} label={`Libraries in ${authority.name}`} />
  <ul class="library-results">
    {entries.map((library) => (
      <li>
        <h3>
          <a href={sitePath(library.url)}>
            {library.name} <ArrowUpRight size={17} aria-hidden="true" />
          </a>
        </h3>
        <p>{library.address}</p>
        {library.permanentlyClosed && <p>{copy.marked_permanently_closed}</p>}
      </li>
    ))}
  </ul>
  <TagListSection heading={copy.services_heading} items={services} />
  <TagListSection
    heading={copy.accessibility}
    items={accessibility.map((value) => facilityLabel(value))}
  />
  <LibraryDownloads entries={entries} authoritySlug={authority.slug} />
  <Fragment slot="aside">
    <section class="detail-section">
      <h2>{copy.library_service}</h2>
      <ContactDetails record={authority} />
    </section>
    {authority.about && (
      <section class="detail-section">
        <h2>{copy.about_service}</h2>
        <p>{authority.about}</p>
      </section>
    )}
    <SocialLinks heading={copy.connect} links={authority.social} />
    <DirectoryProvenance record={authority} />
  </Fragment>
</DirectoryLayout>
