---
import { ArrowUpRight, MapPin, Navigation } from '@lucide/astro'

import ContactDetails from '../components/ContactDetails.astro'
import DirectoryProvenance from '../components/DirectoryProvenance.astro'
import LibraryMap from '../components/LibraryMap.astro'
import OpeningHours from '../components/OpeningHours.astro'
import ShareButtons from '../components/ShareButtons.astro'
import TagListSection from '../components/TagListSection.astro'
import NewsList from '../components/NewsList.astro'
import DirectoryLayout from '../layouts/DirectoryLayout.astro'
import { libraries, facilityLabel } from '../lib/directory/directoryLoader.mjs'
import { canonicalInternalPath, safeURL, settings, sitePath } from '../lib/site/siteHelpers.mjs'
import { generateLibrarySchema } from '../lib/site/seoHelpers.mjs'
import {
  getNewsForLibrary,
  getNewsSummaryForAuthority,
  getNewsSummaryForLibrary
} from '../lib/content/newsHelpers.mjs'

const { library, authority } = Astro.props
const copy = settings.ui.directory
const maps = library.mapLinks
const nearby = library.nearby(libraries)
const newsStories = getNewsForLibrary(library.id)
const newsSummary = getNewsSummaryForLibrary(library.id)
const hasNews = newsStories.length > 0 || (newsSummary && newsSummary.total > 0)
const totalNewsCount = newsSummary?.total ?? newsStories.length
const authorityNewsSummary = authority
  ? getNewsSummaryForAuthority(authority.gss, authority.slug, authority.name)
  : null
const authorityNewsCount = authorityNewsSummary?.total ?? 0
const tags = [
  authority?.country,
  library.operatingModel,
  hasNews && totalNewsCount > 0
    ? {
        label: `${totalNewsCount.toLocaleString('en-GB')} news ${totalNewsCount === 1 ? 'story' : 'stories'}`,
        href: '#news-list-heading'
      }
    : null
].filter(Boolean)

const siteBase = Astro.site ? Astro.site.href : settings.site.url
const canonicalUrl = Astro.site
  ? new URL(canonicalInternalPath(Astro.url.pathname), Astro.site).href
  : `${siteBase.replace(/\/+$/, '')}${Astro.url.pathname}`

const librarySchema = generateLibrarySchema(library, authority, canonicalUrl)
---

<DirectoryLayout
  title={library.name}
  description={`${library.name}. ${library.address}. ${copy.description_suffix}`}
  subtitle={library.address}
  authority={authority}
  tags={tags}
  schema={librarySchema}
>
  {library.permanentlyClosed && <p class="notice">{copy.permanently_closed}</p>}
  <LibraryMap
    libraries={[library]}
    label={`${library.name} location`}
    emptyMessage="Coordinates are not recorded for this library."
  />
  <section class="detail-section">
    <h2>{copy.visit_contact}</h2>
    <ContactDetails
      record={library}
      address={library.address}
      fallbackWebsite={authority?.website}
    />
  </section>
  <slot />
  <TagListSection heading={copy.services_heading} items={library.services} />
  <TagListSection
    heading={copy.accessibility}
    items={library.accessibility?.map((value) => facilityLabel(value))}
  />
  <TagListSection
    heading={copy.co_located_services}
    items={library.coLocated?.map((value) => facilityLabel(value))}
  />
  {library.notes && (
    <section class="detail-section">
      <h2>{copy.library_notes}</h2>
      <p>{library.notes}</p>
    </section>
  )}
  {maps && (
    <section class="detail-section getting-here-section">
      <h2>{copy.getting_here}</h2>
      <div class="getting-here-actions">
        <a href={maps.google} class="directions-card" target="_blank" rel="noopener noreferrer">
          <div class="directions-card-icon">
            <Navigation size={22} aria-hidden="true" />
          </div>
          <div class="directions-card-content">
            <span class="directions-card-title">
              Google Maps <ArrowUpRight size={15} aria-hidden="true" />
            </span>
            <span class="directions-card-subtitle">Driving, transit, walking directions</span>
          </div>
        </a>
        <a href={maps.apple} class="directions-card" target="_blank" rel="noopener noreferrer">
          <div class="directions-card-icon">
            <MapPin size={22} aria-hidden="true" />
          </div>
          <div class="directions-card-content">
            <span class="directions-card-title">
              Apple Maps <ArrowUpRight size={15} aria-hidden="true" />
            </span>
            <span class="directions-card-subtitle">Launch Maps on iPhone, iPad or Mac</span>
          </div>
        </a>
      </div>
    </section>
  )}
  {nearby.length > 0 && (
    <section class="detail-section nearby-section">
      <h2>{copy.nearby_libraries}</h2>
      <ul class="library-results" data-library-list>
        {nearby.map(({ library: other, miles }) => (
          <li data-hours={JSON.stringify(other.hours || other.openingTimes || null)}>
            <div class="library-result-header">
              <h3>
                <a href={sitePath(other.url)}>
                  {other.name} <ArrowUpRight size={17} aria-hidden="true" />
                </a>
              </h3>
              <span class="distance-badge">
                {miles.toFixed(1)} {copy.miles}
              </span>
            </div>
            <p>{other.address || other.postcode}</p>
            <div class="library-result-meta">
              <span class="authority-label">
                {other.authorityName || copy.unassigned_authority}
                {other.country ? ` · ${other.country}` : ''}
              </span>
              <span class="live-status-pill live-status-pill--small" data-open-status />
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
  {safeURL(library.virtualTourUrl) && (
    <section class="detail-section">
      <h2>{copy.virtual_tour}</h2>
      <a href={safeURL(library.virtualTourUrl)}>
        {copy.open_virtual_tour} <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </section>
  )}

  {hasNews ? (
    <section class="detail-section">
      <NewsList
        stories={newsStories}
        summary={newsSummary}
        title={`News & Updates for ${library.name}`}
        subtitle="Stories mentioning this library in Public Libraries News."
      />
    </section>
  ) : (
    authority &&
    authorityNewsCount > 0 && (
      <section class="detail-section">
        <h2>Public Libraries News</h2>
        <p class="news-authority-fallback">
          No branch-specific news stories are recorded for {library.name}. View{' '}
          <a href={`${sitePath(`/libraries/${authority.slug}/`)}#news-list-heading`}>
            {authorityNewsCount.toLocaleString('en-GB')} service-wide news stories for{' '}
            {authority.name}
          </a>
          .
        </p>
      </section>
    )
  )}

  <ShareButtons
    title={library.name}
    description={`${library.name}. ${library.address}.`}
    heading="Share this library"
  />

  <Fragment slot="aside">
    <OpeningHours library={library} />
    <DirectoryProvenance record={library} />
    {authority && (
      <a class="button button-secondary" href={sitePath(`/libraries/${authority.slug}/`)}>
        {copy.more_in_prefix} {authority.name} <ArrowUpRight size={17} aria-hidden="true" />
      </a>
    )}
  </Fragment>
</DirectoryLayout>

<script>
  import { updateLibraryListStatus } from '../lib/directory/openingHoursHelpers.mjs'
  updateLibraryListStatus()
</script>
