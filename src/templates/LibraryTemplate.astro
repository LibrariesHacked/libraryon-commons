---
import { ArrowUpRight } from '@lucide/astro'

import ContactDetails from '../components/ContactDetails.astro'
import DirectoryProvenance from '../components/DirectoryProvenance.astro'
import LibraryMap from '../components/LibraryMap.astro'
import OpeningHours from '../components/OpeningHours.astro'
import TagListSection from '../components/TagListSection.astro'
import DirectoryLayout from '../layouts/DirectoryLayout.astro'
import { libraries, facilityLabel } from '../lib/directory.mjs'
import { safeURL, settings, sitePath } from '../lib/site.mjs'
const { library, authority } = Astro.props
const copy = settings.ui.directory
const maps = library.mapLinks
const nearby = library.nearby(libraries)
const tags = [authority?.country, library.operatingModel].filter(Boolean)
---

<DirectoryLayout
  title={library.name}
  description={`${library.name}. ${library.address}. ${copy.description_suffix}`}
  subtitle={library.address}
  authority={authority}
  tags={tags}
>
  {library.permanentlyClosed && <p class="notice">{copy.permanently_closed}</p>}
  <LibraryMap
    libraries={[library]}
    label={`${library.name} location`}
    emptyMessage="Coordinates are not recorded for this library."
  />
  <section class="detail-section">
    <h2>{copy.visit_contact}</h2>
    <ContactDetails
      record={library}
      address={library.address}
      fallbackWebsite={authority?.website}
    />
  </section>
  <slot />
  <TagListSection heading={copy.services_heading} items={library.services} />
  <TagListSection
    heading={copy.accessibility}
    items={library.accessibility?.map((value) => facilityLabel(value))}
  />
  <TagListSection
    heading={copy.co_located_services}
    items={library.coLocated?.map((value) => facilityLabel(value))}
  />
  {library.notes && (
    <section class="detail-section">
      <h2>{copy.library_notes}</h2>
      <p>{library.notes}</p>
    </section>
  )}
  {maps && (
    <section class="detail-section">
      <h2>{copy.getting_here}</h2>
      <ul class="contact-list">
        <li>
          <a href={maps.google}>
            {copy.google_maps} <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </li>
        <li>
          <a href={maps.apple}>
            {copy.apple_maps} <ArrowUpRight size={15} aria-hidden="true" />
          </a>
        </li>
      </ul>
    </section>
  )}
  {nearby.length > 0 && (
    <section class="detail-section">
      <h2>{copy.nearby_libraries}</h2>
      <ul class="library-results">
        {nearby.map(({ library: other, miles }) => (
          <li>
            <h3>
              <a href={sitePath(other.url)}>{other.name}</a>
            </h3>
            <p>
              {miles.toFixed(1)} {copy.miles}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}
  {safeURL(library.virtualTourUrl) && (
    <section class="detail-section">
      <h2>{copy.virtual_tour}</h2>
      <a href={safeURL(library.virtualTourUrl)}>
        {copy.open_virtual_tour} <ArrowUpRight size={16} aria-hidden="true" />
      </a>
    </section>
  )}
  <Fragment slot="aside">
    <OpeningHours library={library} />
    <DirectoryProvenance record={library} />
    {authority && (
      <a class="button button-secondary" href={sitePath(`/libraries/${authority.slug}/`)}>
        {copy.more_in_prefix} {authority.name} <ArrowUpRight size={17} aria-hidden="true" />
      </a>
    )}
  </Fragment>
</DirectoryLayout>
