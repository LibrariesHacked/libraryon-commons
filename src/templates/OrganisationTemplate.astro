---
import { render } from 'astro:content'
import { ArrowUpRight, Building2 } from '@lucide/astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import NewsList from '../components/NewsList.astro'
import StatusPill from '../components/StatusPill.astro'
import {
  getNewsForOrganisation,
  getNewsSummaryForOrganisation
} from '../lib/content/newsHelpers.mjs'
import { settings, sitePath } from '../lib/site/siteHelpers.mjs'
import { authorities } from '../lib/directory/directoryLoader.mjs'

const { organisation } = Astro.props
const { Content } = await render(organisation)
const isLocalAuthorities = organisation.data.slug === 'local-authorities'
const showNews = !['local-authorities', 'the-public'].includes(organisation.data.slug)
const stories = showNews ? getNewsForOrganisation(organisation.data.slug) : []
const summary = showNews ? getNewsSummaryForOrganisation(organisation.data.slug) : null
const totalStories = summary?.total ?? stories.length
const sortedAuthorities = isLocalAuthorities
  ? [...authorities].sort((a, b) => a.name.localeCompare(b.name, 'en'))
  : []
---

<SiteLayout
  title={organisation.data.name}
  description={
    organisation.data.description ||
    (showNews
      ? `${organisation.data.name} profile and public library news stories.`
      : `${organisation.data.name} profile.`)
  }
>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs
        items={[
          { label: settings.ui.editorial?.home_breadcrumb || 'Home', href: '/' },
          { label: 'Library stakeholders', href: '/organisations/' },
          { label: organisation.data.name, current: true }
        ]}
      />
      <p class="eyebrow">Library Sector Stakeholder</p>
      <h1>{organisation.data.name}</h1>
      {organisation.data.role && (
        <div class="org-role-badge">
          <StatusPill variant="green">
            <Building2 size={15} aria-hidden="true" />
            <span>{organisation.data.role}</span>
          </StatusPill>
        </div>
      )}
      {organisation.data.description && (
        <p class="org-lead-description">{organisation.data.description}</p>
      )}
    </div>
  </header>

  <main class="section shell">
    <div class="org-profile-layout">
      <div class="org-main-content">
        <section class="org-biography-section">
          <h2>About {organisation.data.acronym || organisation.data.name}</h2>
          <div class="prose">
            <Content />
          </div>
        </section>

        {isLocalAuthorities && (
          <section class="org-authorities-section">
            <h2>UK Library Authorities ({sortedAuthorities.length})</h2>
            <p>
              Every local authority in the UK responsible for statutory public library provision:
            </p>
            <div class="article-grid">
              {sortedAuthorities.map((auth) => (
                <a class="content-card" href={sitePath(`/libraries/${auth.slug}/`)}>
                  <div class="content-card-body">
                    <h3 class="content-card-heading">
                      <span>{auth.name}</span>
                      <ArrowUpRight class="content-card-arrow" size={18} aria-hidden="true" />
                    </h3>
                    <div class="org-card-pills">
                      {auth.country && <StatusPill variant="apricot">{auth.country}</StatusPill>}
                      <StatusPill variant="green">{auth.library_ids.length} libraries</StatusPill>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {showNews && (
          <section class="org-news-section">
            <NewsList
              stories={stories}
              summary={summary}
              title={`Public Libraries News Stories`}
              subtitle={`Roundups and reports mentioning ${organisation.data.name} in Public Libraries News.`}
              emptyMessage={`No news stories currently recorded mentioning ${organisation.data.name}.`}
            />
          </section>
        )}
      </div>

      <aside class="org-sidebar">
        <div class="sidebar-card">
          <h3>Organisation Details</h3>
          <dl class="org-details-list">
            {organisation.data.acronym && (
              <div class="detail-row">
                <dt>Acronym</dt>
                <dd>{organisation.data.acronym}</dd>
              </div>
            )}
            {organisation.data.country && (
              <div class="detail-row">
                <dt>Country</dt>
                <dd>{organisation.data.country}</dd>
              </div>
            )}
            {organisation.data.website && (
              <div class="detail-row">
                <dt>Official Website</dt>
                <dd>
                  <a
                    href={organisation.data.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="external-link"
                  >
                    <span>Visit website</span>
                    <ArrowUpRight size={14} aria-hidden="true" />
                  </a>
                </dd>
              </div>
            )}
            {showNews && (
              <div class="detail-row">
                <dt>News Mentions</dt>
                <dd>
                  <strong>{totalStories.toLocaleString('en-GB')} archive stories</strong>
                  {summary?.first_year && summary?.latest_year && (
                    <span class="detail-subtext">
                      {summary.first_year}–{summary.latest_year} coverage
                    </span>
                  )}
                </dd>
              </div>
            )}
          </dl>

          {organisation.data.tags && organisation.data.tags.length > 0 && (
            <div class="org-tags-block">
              <h4>Themes</h4>
              <div class="tag-pills">
                {organisation.data.tags.map((tag) => (
                  <StatusPill variant="plum">{tag}</StatusPill>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </main>
</SiteLayout>
