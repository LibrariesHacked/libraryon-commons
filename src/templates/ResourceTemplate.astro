---
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ResourceLink from '../components/ResourceLink.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { safeURL, settings } from '../lib/helpers/siteHelpers.mjs'
const { resource, usage = [] } = Astro.props
const copy = settings.ui.resources
const breadcrumbs = [
  { label: settings.ui.editorial.home_breadcrumb, href: '/' },
  { label: copy.breadcrumb, href: '/resources/' },
  { label: resource.title, current: true }
]
---

<SiteLayout title={resource.title} description={resource.description}>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">{resource.kind}</p>
      <h1>{resource.title}</h1>
    </div>
  </header>
  <section class="section shell">
    <div class="prose">
      {resource.description && <p>{resource.description}</p>}
      <ResourceLink resource={resource} />
      {usage.length > 0 && (
        <section class="resource-used-in">
          <h2>{settings.ui.resources.used_in}</h2>
          <ul>
            {usage.map((reference) => (
              <li>
                <a href={safeURL(reference.href)}>{reference.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <dl>
        {resource.credit && (
          <>
            <dt>{copy.credit}</dt>
            <dd>{resource.credit}</dd>
          </>
        )}
        {resource.licence && (
          <>
            <dt>{copy.rights}</dt>
            <dd>{resource.licence}</dd>
          </>
        )}
      </dl>
      {safeURL(resource.source_url) && (
        <p class="source-note">
          <a href={safeURL(resource.source_url)}>{copy.original_source}</a>
        </p>
      )}
    </div>
  </section>
</SiteLayout>
