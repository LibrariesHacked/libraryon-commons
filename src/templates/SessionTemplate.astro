---
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ResourceLink from '../components/ResourceLink.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { articleTitle, settings } from '../lib/helpers/siteHelpers.mjs'
const { session, conference, resources } = Astro.props
const copy = settings.ui.sessions
const breadcrumbs = [
  { label: settings.ui.editorial.home_breadcrumb, href: '/' },
  { label: articleTitle(conference), href: conference.data.path },
  { label: session.title, current: true }
]
---

<SiteLayout title={session.title} description={session.description}>
  <header class="page-heading">
    <div class="shell">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">{session.theme}</p>
      <h1>{session.title}</h1>
    </div>
  </header>
  <section class="section shell">
    <div class="prose">
      <p>{session.description}</p>
      {session.speakers?.length > 0 && (
        <>
          <h2>{copy.speakers}</h2>
          <ul>
            {session.speakers.map((speaker) => (
              <li>
                {speaker.name}
                {speaker.organisation && `, ${speaker.organisation}`}
              </li>
            ))}
          </ul>
        </>
      )}
      <h2>{copy.resources}</h2>
      <ul class="resource-list">
        {resources.map((resource) => (
          <li>
            <ResourceLink resource={resource} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</SiteLayout>
